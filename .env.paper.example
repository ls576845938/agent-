# QuantStation vNext — Alpaca Paper Trading Configuration
# Copy to .env.paper and fill in your Alpaca Paper API credentials.
# NEVER commit real credentials.

# Alpaca Paper API (https://app.alpaca.markets/paper/dashboard)
APCA_API_KEY_ID=your_paper_key_here
APCA_API_SECRET_KEY=your_paper_secret_here
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Runtime profile
QUANT_RUNTIME_PROFILE=paper

# CRITICAL: Must be false for paper trading.
# Only set to true for live production — requires additional gates.
QUANT_LIVE_SUBMISSION_ENABLED=false

# Optional: Telegram alerts
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
