{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/btc_candidate_metric_repair_report.schema.json",
  "title": "QuantStation VNEXT BTC Candidate Metric Repair Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "asset",
    "symbol",
    "status",
    "paper_review_pending_allowed",
    "promotion_allowed",
    "source_artifacts",
    "best_candidate",
    "gate_thresholds",
    "failed_metrics",
    "fold_failure_diagnostics",
    "ablation_diagnostics",
    "recommended_repair_actions",
    "safety",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "btc_candidate_metric_repair_report_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "asset": {"const": "btc"},
    "symbol": {"const": "BTCUSDT"},
    "status": {
      "enum": [
        "blocked_by_perpetual_data_cost",
        "needs_metric_repair",
        "needs_candidate_promotion_decision",
        "candidate_metric_gate_passed"
      ]
    },
    "paper_review_pending_allowed": {"type": "boolean"},
    "promotion_allowed": {"type": "boolean"},
    "source_artifacts": {
      "type": "object",
      "required": [
        "candidate_gate",
        "walk_forward_fold_attribution",
        "exit_surgery_ablation",
        "side_regime_ablation"
      ],
      "properties": {
        "candidate_gate": {"type": ["string", "null"]},
        "walk_forward_fold_attribution": {"type": ["string", "null"]},
        "exit_surgery_ablation": {"type": ["string", "null"]},
        "side_regime_ablation": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "best_candidate": {"$ref": "#/$defs/candidateSummary"},
    "gate_thresholds": {
      "type": "object",
      "required": [
        "event_profit_factor",
        "walk_forward_pass_rate",
        "regime_pass_rate",
        "cost_stress_required"
      ],
      "properties": {
        "event_profit_factor": {"type": ["number", "null"]},
        "walk_forward_pass_rate": {"type": ["number", "null"]},
        "regime_pass_rate": {"type": ["number", "null"]},
        "cost_stress_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "failed_metrics": {
      "type": "array",
      "items": {
        "enum": ["event_profit_factor", "walk_forward_pass_rate", "regime_pass_rate", "cost_stress"]
      }
    },
    "fold_failure_diagnostics": {
      "type": "object",
      "required": [
        "source_strategy_id",
        "method",
        "pass_rate",
        "failed_folds",
        "failure_sources",
        "fold_count",
        "stable_rules",
        "unstable_or_overfit_rules"
      ],
      "properties": {
        "source_strategy_id": {"type": "string"},
        "method": {"type": "string"},
        "pass_rate": {"type": ["number", "null"]},
        "failed_folds": {"type": "array", "items": {"type": "integer"}},
        "failure_sources": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "fold_count": {"type": "integer", "minimum": 0},
        "stable_rules": {"type": "array", "items": {"type": "string"}},
        "unstable_or_overfit_rules": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "ablation_diagnostics": {
      "type": "object",
      "required": [
        "exit_surgery_best",
        "side_regime_best",
        "adopted_exit_rules",
        "adopted_side_rules",
        "rejected_exit_rules",
        "rejected_side_rules",
        "short_reintroduction_rejected"
      ],
      "properties": {
        "exit_surgery_best": {"$ref": "#/$defs/ablationBest"},
        "side_regime_best": {"$ref": "#/$defs/ablationBest"},
        "adopted_exit_rules": {"type": "array", "items": {"type": "string"}},
        "adopted_side_rules": {"type": "array", "items": {"type": "string"}},
        "rejected_exit_rules": {"type": "array", "items": {"type": "string"}},
        "rejected_side_rules": {"type": "array", "items": {"type": "string"}},
        "short_reintroduction_rejected": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "recommended_repair_actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repairAction"}
    },
    "safety": {
      "type": "object",
      "required": [
        "report_only",
        "strategy_retest_allowed",
        "paper_or_live_unlock_allowed",
        "ordinary_profit_factor_diagnostic_only",
        "requires_event_ledger_fills_pnl",
        "requires_walk_forward_pass",
        "requires_cost_stress_pass",
        "requires_perpetual_data_cost_evidence"
      ],
      "properties": {
        "report_only": {"const": true},
        "strategy_retest_allowed": {"type": "boolean"},
        "paper_or_live_unlock_allowed": {"const": false},
        "ordinary_profit_factor_diagnostic_only": {"const": true},
        "requires_event_ledger_fills_pnl": {"const": true},
        "requires_walk_forward_pass": {"const": true},
        "requires_cost_stress_pass": {"const": true},
        "requires_perpetual_data_cost_evidence": {"const": true}
      },
      "additionalProperties": false
    },
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "candidate_metric_gate_passed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "promotion_allowed": {"const": true},
          "paper_review_pending_allowed": {"const": true},
          "failed_metrics": {"maxItems": 0},
          "blockers": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"not": {"properties": {"status": {"const": "candidate_metric_gate_passed"}}}},
      "then": {
        "properties": {
          "promotion_allowed": {"const": false},
          "paper_review_pending_allowed": {"const": false},
          "blockers": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "candidateSummary": {
      "type": "object",
      "required": [
        "strategy_id",
        "source_run_dir",
        "status",
        "passed_metric_count",
        "required_metric_count",
        "failed_metrics",
        "metrics",
        "thresholds"
      ],
      "properties": {
        "strategy_id": {"type": "string"},
        "source_run_dir": {"type": "string"},
        "status": {"type": "string"},
        "passed_metric_count": {"type": "integer", "minimum": 0},
        "required_metric_count": {"type": "integer", "minimum": 0},
        "failed_metrics": {"type": "array", "items": {"type": "string"}},
        "metrics": {
          "type": "object",
          "required": [
            "event_profit_factor",
            "walk_forward_pass_rate",
            "regime_pass_rate",
            "profit_factor",
            "dsr",
            "pbo",
            "max_drawdown",
            "trade_count",
            "fill_count"
          ],
          "properties": {
            "event_profit_factor": {"type": ["number", "null"]},
            "walk_forward_pass_rate": {"type": ["number", "null"]},
            "regime_pass_rate": {"type": ["number", "null"]},
            "profit_factor": {"type": ["number", "null"]},
            "dsr": {"type": ["number", "null"]},
            "pbo": {"type": ["number", "null"]},
            "max_drawdown": {"type": ["number", "null"]},
            "trade_count": {"type": ["integer", "null"]},
            "fill_count": {"type": ["integer", "null"]}
          },
          "additionalProperties": false
        },
        "thresholds": {
          "type": "object",
          "required": ["event_profit_factor", "walk_forward_pass_rate", "regime_pass_rate"],
          "properties": {
            "event_profit_factor": {"type": ["number", "null"]},
            "walk_forward_pass_rate": {"type": ["number", "null"]},
            "regime_pass_rate": {"type": ["number", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ablationBest": {
      "type": "object",
      "required": [
        "mode",
        "event_profit_factor",
        "walk_forward_pass_rate",
        "regime_pass_rate",
        "max_drawdown",
        "gate_status",
        "fail_reasons"
      ],
      "properties": {
        "mode": {"type": "string"},
        "event_profit_factor": {"type": ["number", "null"]},
        "walk_forward_pass_rate": {"type": ["number", "null"]},
        "regime_pass_rate": {"type": ["number", "null"]},
        "max_drawdown": {"type": ["number", "null"]},
        "gate_status": {"type": "string"},
        "fail_reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "repairAction": {
      "type": "object",
      "required": ["name", "priority", "status", "reason", "inputs"],
      "properties": {
        "name": {"type": "string"},
        "priority": {"type": "integer", "minimum": 1},
        "status": {"enum": ["blocked", "pending", "guardrail"]},
        "reason": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
