{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/btc_true_scalping_ws_l2_raw_capture_quality_report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "asset",
    "symbol",
    "venue_symbol",
    "scope",
    "status",
    "decision",
    "next_required_action",
    "source_reports",
    "selected_bundle_dir",
    "thresholds",
    "source_files",
    "capture_quality",
    "validation",
    "blockers",
    "format_contract_satisfied",
    "contract_satisfied",
    "event_ledger_feature_validation_allowed",
    "true_scalping_allowed",
    "candidate_generation_allowed",
    "strategy_skeleton_generation_allowed",
    "promotion_allowed",
    "paper_review_pending_allowed",
    "paper_or_live_unlock_allowed",
    "guardrails"
  ],
  "properties": {
    "schema_version": {"const": "btc_true_scalping_ws_l2_raw_capture_quality_report_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "asset": {"const": "btc"},
    "symbol": {"const": "BTCUSDT"},
    "venue_symbol": {"const": "BTC-USDT-SWAP"},
    "scope": {"const": "research_only_ws_l2_raw_capture_quality_no_candidate_no_paper_no_live"},
    "status": {
      "enum": [
        "ws_l2_raw_capture_format_verified_research_only_history_insufficient",
        "ws_l2_raw_capture_missing_or_invalid_research_only"
      ]
    },
    "decision": {"const": "continue_public_ws_l2_capture_then_build_order_book_replay_and_resync_policy_before_true_scalping"},
    "next_required_action": {"type": "string"},
    "source_reports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ws_capture_report"],
      "properties": {
        "ws_capture_report": {"type": ["string", "null"]}
      }
    },
    "selected_bundle_dir": {"type": "string"},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_research_capture_seconds",
        "minimum_event_ledger_history_days",
        "minimum_data_messages",
        "required_channels"
      ],
      "properties": {
        "minimum_research_capture_seconds": {"type": "integer", "minimum": 3600},
        "minimum_event_ledger_history_days": {"type": "integer", "minimum": 30},
        "minimum_data_messages": {"type": "integer", "minimum": 1},
        "required_channels": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string"}
        }
      }
    },
    "source_files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_messages", "raw_capture_manifest"],
      "properties": {
        "raw_messages": {"$ref": "#/$defs/rawFileQuality"},
        "raw_capture_manifest": {"$ref": "#/$defs/manifestQuality"}
      }
    },
    "capture_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_count",
        "data_message_count",
        "trade_message_count",
        "book_message_count",
        "channel_counts",
        "capture_duration_seconds",
        "event_ledger_history_days",
        "local_receive_timestamp_present",
        "monotonic_timestamp_present",
        "monotonic_order_pass",
        "exchange_ts_observed",
        "sequence_or_checksum_observed",
        "required_channels_observed",
        "minimum_research_capture_seconds_satisfied",
        "minimum_event_ledger_history_days_satisfied"
      ],
      "properties": {
        "message_count": {"type": "integer", "minimum": 0},
        "data_message_count": {"type": "integer", "minimum": 0},
        "trade_message_count": {"type": "integer", "minimum": 0},
        "book_message_count": {"type": "integer", "minimum": 0},
        "channel_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "capture_duration_seconds": {"type": "number", "minimum": 0},
        "event_ledger_history_days": {"type": "number", "minimum": 0},
        "local_receive_timestamp_present": {"type": "boolean"},
        "monotonic_timestamp_present": {"type": "boolean"},
        "monotonic_order_pass": {"type": "boolean"},
        "exchange_ts_observed": {"type": "boolean"},
        "sequence_or_checksum_observed": {"type": "boolean"},
        "required_channels_observed": {"type": "boolean"},
        "minimum_research_capture_seconds_satisfied": {"type": "boolean"},
        "minimum_event_ledger_history_days_satisfied": {"type": "boolean"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_ready",
        "public_source_boundary_satisfied",
        "required_channels_observed",
        "raw_message_timestamps_ready",
        "raw_l2_sequence_or_checksum_observed",
        "raw_l2_capture_format_satisfied",
        "minimum_research_capture_seconds_satisfied",
        "minimum_event_ledger_history_days_satisfied",
        "order_book_replay_ready",
        "execution_latency_model_ready",
        "queue_model_ready",
        "format_contract_satisfied",
        "capture_report_status",
        "manifest_public_ws_only"
      ],
      "properties": {
        "files_ready": {"type": "boolean"},
        "public_source_boundary_satisfied": {"type": "boolean"},
        "required_channels_observed": {"type": "boolean"},
        "raw_message_timestamps_ready": {"type": "boolean"},
        "raw_l2_sequence_or_checksum_observed": {"type": "boolean"},
        "raw_l2_capture_format_satisfied": {"type": "boolean"},
        "minimum_research_capture_seconds_satisfied": {"type": "boolean"},
        "minimum_event_ledger_history_days_satisfied": {"type": "boolean"},
        "order_book_replay_ready": {"const": false},
        "execution_latency_model_ready": {"const": false},
        "queue_model_ready": {"const": false},
        "format_contract_satisfied": {"type": "boolean"},
        "capture_report_status": {"type": "string"},
        "manifest_public_ws_only": {"type": "boolean"}
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "format_contract_satisfied": {"type": "boolean"},
    "contract_satisfied": {"const": false},
    "event_ledger_feature_validation_allowed": {"const": false},
    "true_scalping_allowed": {"const": false},
    "candidate_generation_allowed": {"const": false},
    "strategy_skeleton_generation_allowed": {"const": false},
    "promotion_allowed": {"const": false},
    "paper_review_pending_allowed": {"const": false},
    "paper_or_live_unlock_allowed": {"const": false},
    "guardrails": {"$ref": "#/$defs/guardrails"}
  },
  "$defs": {
    "rawFileQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "row_count", "required_fields_present"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "exists": {"type": "boolean"},
        "row_count": {"type": "integer", "minimum": 0},
        "required_fields_present": {"type": "boolean"}
      }
    },
    "manifestQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "exists",
        "row_count",
        "required_fields_present",
        "missing_fields",
        "public_data_only",
        "public_channel_count"
      ],
      "properties": {
        "path": {"type": ["string", "null"]},
        "exists": {"type": "boolean"},
        "row_count": {"type": "integer", "minimum": 0},
        "required_fields_present": {"type": "boolean"},
        "missing_fields": {"type": "array", "items": {"type": "string"}},
        "public_data_only": {"type": "boolean"},
        "public_channel_count": {"type": "integer", "minimum": 0}
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_only",
        "production_ready",
        "paper_or_live_usable",
        "private_endpoints_allowed",
        "order_endpoints_allowed",
        "broker_calls_allowed",
        "real_orders_created",
        "future_label_used_for_signal",
        "lookahead_used_for_signal",
        "paper_queue",
        "live"
      ],
      "properties": {
        "research_only": {"const": true},
        "production_ready": {"const": false},
        "paper_or_live_usable": {"const": false},
        "private_endpoints_allowed": {"const": false},
        "order_endpoints_allowed": {"const": false},
        "broker_calls_allowed": {"const": false},
        "real_orders_created": {"const": false},
        "future_label_used_for_signal": {"const": false},
        "lookahead_used_for_signal": {"const": false},
        "paper_queue": {"const": "LOCKED"},
        "live": {"const": "FROZEN"}
      }
    }
  }
}
