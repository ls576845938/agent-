{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/btc_perpetual_bundle_preflight_report.schema.json",
  "title": "QuantStation VNEXT BTC Perpetual Bundle Preflight Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "bundle_root",
    "selected_bundle_id",
    "selected_bundle_dir",
    "selected_bundle_manifest_path",
    "explicit_bundle_selection_confirmed",
    "source_type",
    "required_files",
    "missing_required_files",
    "manifest_missing_file_entries",
    "disk_missing_required_files",
    "sha256_missing_files",
    "record_count_missing_files",
    "sample_range_missing_files",
    "source_missing_files",
    "required_files_present",
    "sha256_present",
    "record_counts_present",
    "sample_range_present",
    "license_note_present",
    "promotion_clean_allowed_by_config",
    "promotion_clean_allowed_by_manifest",
    "preflight_pass",
    "blockers",
    "next_required_action"
  ],
  "properties": {
    "schema_version": {"const": "btc_perpetual_bundle_preflight_report_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "bundle_root": {"type": "string"},
    "selected_bundle_id": {"type": ["string", "null"]},
    "selected_bundle_dir": {"type": ["string", "null"]},
    "selected_bundle_manifest_path": {"type": ["string", "null"]},
    "explicit_bundle_selection_confirmed": {"type": "boolean"},
    "source_type": {"type": ["string", "null"]},
    "required_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "disk_file_exists",
          "manifest_entry_present",
          "sha256_present",
          "record_count_present",
          "sample_range_present",
          "source_present"
        ],
        "properties": {
          "path": {"type": "string"},
          "role": {"type": "string"},
          "disk_file_exists": {"type": "boolean"},
          "manifest_entry_present": {"type": "boolean"},
          "sha256_present": {"type": "boolean"},
          "record_count_present": {"type": "boolean"},
          "sample_range_present": {"type": "boolean"},
          "source_present": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "missing_required_files": {"type": "array", "items": {"type": "string"}},
    "manifest_missing_file_entries": {"type": "array", "items": {"type": "string"}},
    "disk_missing_required_files": {"type": "array", "items": {"type": "string"}},
    "sha256_missing_files": {"type": "array", "items": {"type": "string"}},
    "record_count_missing_files": {"type": "array", "items": {"type": "string"}},
    "sample_range_missing_files": {"type": "array", "items": {"type": "string"}},
    "source_missing_files": {"type": "array", "items": {"type": "string"}},
    "required_files_present": {"type": "boolean"},
    "sha256_present": {"type": "boolean"},
    "record_counts_present": {"type": "boolean"},
    "sample_range_present": {"type": "boolean"},
    "license_note_present": {"type": "boolean"},
    "promotion_clean_allowed_by_config": {"type": "boolean"},
    "promotion_clean_allowed_by_manifest": {"type": "boolean"},
    "preflight_pass": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "next_required_action": {
      "enum": ["none", "manual_capture_metadata_from_allowed_network", "repair_btc_perpetual_bundle_manifest"]
    }
  },
  "additionalProperties": false
}
