{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/btc_tail_dependency_report.schema.json",
  "title": "QuantStation VNEXT BTC Tail Dependency Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "source_type",
    "input_returns_source",
    "ledger_returns_source",
    "tail_event_definition",
    "left_tail_threshold",
    "right_tail_threshold",
    "tail_event_count",
    "worst_tail_loss",
    "best_tail_gain",
    "tail_concentration_ratio",
    "extreme_event_dependency_score",
    "single_event_pnl_contribution_ratio",
    "tail_dependency_pass",
    "promotion_evidence",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "btc_tail_dependency_report_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "source_type": {"type": "string"},
    "input_returns_source": {"type": ["string", "null"]},
    "ledger_returns_source": {"type": ["string", "null"]},
    "tail_event_definition": {"type": "string"},
    "left_tail_threshold": {"type": "number"},
    "right_tail_threshold": {"type": "number"},
    "tail_event_count": {"type": "integer", "minimum": 0},
    "worst_tail_loss": {"type": ["number", "null"]},
    "best_tail_gain": {"type": ["number", "null"]},
    "tail_concentration_ratio": {"type": "number"},
    "extreme_event_dependency_score": {"type": "number"},
    "single_event_pnl_contribution_ratio": {"type": "number"},
    "tail_dependency_pass": {"type": "boolean"},
    "promotion_evidence": {"const": false},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
