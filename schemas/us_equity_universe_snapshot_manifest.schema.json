{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_universe_snapshot_manifest.schema.json",
  "title": "QuantStation VNEXT US Equity Universe Snapshot Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "universe_version",
    "universe_name",
    "source_type",
    "as_of_date",
    "sample_start",
    "sample_end",
    "symbol_count",
    "symbols_hash",
    "membership_events_available",
    "membership_events_source",
    "point_in_time_confirmed",
    "delisted_symbols_included",
    "delisting_source",
    "survivorship_risk",
    "selected_provider",
    "provider_verification_report_path",
    "provider_verified_for_promotion",
    "identifier_mapping_available",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_universe_snapshot_manifest_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "universe_version": {"type": "string"},
    "universe_name": {"type": "string"},
    "source_type": {
      "enum": [
        "derived_from_bars",
        "static_symbol_list",
        "provider_snapshot",
        "point_in_time_membership",
        "unknown"
      ]
    },
    "as_of_date": {"type": "string"},
    "sample_start": {"type": "string"},
    "sample_end": {"type": "string"},
    "symbol_count": {"type": "integer", "minimum": 0},
    "symbols_hash": {"type": "string"},
    "membership_events_available": {"type": "boolean"},
    "membership_events_source": {"type": ["string", "null"]},
    "point_in_time_confirmed": {"type": "boolean"},
    "delisted_symbols_included": {"type": "boolean"},
    "delisting_source": {"type": ["string", "null"]},
    "survivorship_risk": {"enum": ["unknown", "likely", "controlled", "clean"]},
    "data_versions": {"type": "array", "items": {"type": "string"}},
    "selected_provider": {"enum": ["yfinance", "local_csv", "crsp", "sharadar", "polygon", "norgate", "none"]},
    "provider_verification_report_path": {"type": "string"},
    "provider_verified_for_promotion": {"type": "boolean"},
    "identifier_mapping_available": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
