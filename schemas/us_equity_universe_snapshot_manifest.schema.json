{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_universe_snapshot_manifest.schema.json",
  "title": "QuantStation VNEXT US Equity Universe Snapshot Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "universe_name",
    "universe_version",
    "source_type",
    "selected_provider",
    "provider_verified_for_promotion",
    "symbol_count",
    "symbols_hash",
    "sample_start",
    "sample_end",
    "as_of_date",
    "point_in_time_confirmed",
    "survivorship_risk",
    "membership_events_available",
    "delisted_symbols_included",
    "identifier_mapping_available",
    "data_versions",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_universe_snapshot_manifest_v1"},
    "generated_at": {"type": "string", "minLength": 1},
    "commit": {"type": ["string", "null"]},
    "branch": {"type": ["string", "null"]},
    "universe_name": {"type": "string", "minLength": 1},
    "universe_version": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["derived_from_bars", "production_pit_bundle"]},
    "selected_provider": {"type": "string", "minLength": 1},
    "provider_verified_for_promotion": {"type": "boolean"},
    "provider_verification_report_path": {"type": "string"},
    "symbol_count": {"type": "integer", "minimum": 0},
    "symbols_hash": {"type": "string", "minLength": 1},
    "sample_start": {"type": ["string", "null"]},
    "sample_end": {"type": ["string", "null"]},
    "as_of_date": {"type": "string", "minLength": 1},
    "point_in_time_confirmed": {"type": "boolean"},
    "survivorship_risk": {"type": "string", "minLength": 1},
    "membership_events_available": {"type": "boolean"},
    "membership_events_source": {"type": ["string", "null"]},
    "delisted_symbols_included": {"type": "boolean"},
    "delisting_source": {"type": ["string", "null"]},
    "identifier_mapping_available": {"type": "boolean"},
    "data_versions": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
