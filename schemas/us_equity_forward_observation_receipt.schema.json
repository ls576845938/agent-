{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_forward_observation_receipt.schema.json",
  "title": "US ETF26 frozen-candidate forward observation receipt",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at_utc",
    "status",
    "decision",
    "run_id",
    "observation",
    "identity",
    "data",
    "states",
    "continuity",
    "windows",
    "blockers",
    "gaps",
    "owners",
    "outputs",
    "guardrails",
    "artifact_identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "us_equity_forward_observation_receipt_v1"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "blocked_contract",
        "blocked_evidence_integrity",
        "blocked_external_data",
        "blocked_observation_evidence",
        "in_progress_natural_time",
        "complete_for_manual_review_only"
      ]
    },
    "decision": {
      "const": "keep_promotion_paper_live_private_order_locked"
    },
    "run_id": {
      "type": "string",
      "pattern": "^us-forward-[0-9a-f]{16}$"
    },
    "observation": {
      "type": "object",
      "required": [
        "natural_day",
        "timezone",
        "recommended_local_time",
        "expected_finalized_session",
        "expected_finalized_session_rule",
        "eligible_receipt"
      ],
      "properties": {
        "natural_day": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "recommended_local_time": {
          "const": "09:20"
        },
        "expected_finalized_session": {
          "type": "string",
          "format": "date"
        },
        "expected_finalized_session_rule": {
          "const": "previous_xnys_trading_session"
        },
        "eligible_receipt": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "source_head",
        "code_tree_hash",
        "candidate_id",
        "candidate_config_sha256",
        "strategy_version",
        "strategy_identity_sha256",
        "parameters_sha256",
        "parameters_frozen",
        "candidate_reselected"
      ],
      "properties": {
        "source_head": {
          "$ref": "#/$defs/commit"
        },
        "code_tree_hash": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "strategy_version": {
          "type": "string",
          "minLength": 1
        },
        "strategy_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parameters_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parameters_frozen": {
          "const": true
        },
        "candidate_reselected": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": [
        "state",
        "producer_role",
        "producer_commit",
        "manifest_git_spec",
        "manifest_sha256",
        "dataset_id",
        "dataset_version",
        "readiness_class",
        "coverage",
        "expected_finalized_session_covered",
        "consumer_read_only",
        "constraints",
        "errors"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "producer_role": {
          "const": "data_steward"
        },
        "producer_commit": {
          "$ref": "#/$defs/commit"
        },
        "manifest_git_spec": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dataset_id": {
          "const": "us-equity-hf-etf26-1min"
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        },
        "readiness_class": {
          "const": "research_ready"
        },
        "coverage": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "minLength": 1
            },
            "end": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "expected_finalized_session_covered": {
          "type": "boolean"
        },
        "consumer_read_only": {
          "const": true
        },
        "constraints": {
          "$ref": "#/$defs/string_list"
        },
        "errors": {
          "$ref": "#/$defs/string_list"
        }
      },
      "additionalProperties": false
    },
    "states": {
      "type": "object",
      "required": [
        "signal",
        "target",
        "fill",
        "ledger"
      ],
      "properties": {
        "signal": {
          "$ref": "#/$defs/state"
        },
        "target": {
          "$ref": "#/$defs/state"
        },
        "fill": {
          "$ref": "#/$defs/state"
        },
        "ledger": {
          "$ref": "#/$defs/state"
        }
      },
      "additionalProperties": false
    },
    "continuity": {
      "type": "object",
      "required": [
        "status",
        "current_streak_natural_days",
        "distinct_trading_session_count",
        "distinct_trading_sessions",
        "interrupts",
        "backfill_used",
        "same_day_rerun_used"
      ],
      "properties": {
        "status": {
          "enum": [
            "blocked",
            "restarted_after_interrupt",
            "continuous"
          ]
        },
        "current_streak_natural_days": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_trading_session_count": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_trading_sessions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "interrupts": {
          "$ref": "#/$defs/string_list"
        },
        "backfill_used": {
          "const": false
        },
        "same_day_rerun_used": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "windows": {
      "type": "object",
      "required": [
        "paper_review_natural_days",
        "independent_confirmation_trading_sessions",
        "substitution_allowed"
      ],
      "properties": {
        "paper_review_natural_days": {
          "allOf": [
            {
              "$ref": "#/$defs/window"
            },
            {
              "properties": {
                "required": {
                  "const": 30
                },
                "semantics": {
                  "const": "paper_review_prerequisite_only"
                }
              }
            }
          ]
        },
        "independent_confirmation_trading_sessions": {
          "type": "object",
          "required": [
            "required",
            "observed",
            "complete",
            "window_start",
            "window_end",
            "semantics"
          ],
          "properties": {
            "required": {
              "const": 252
            },
            "observed": {
              "type": "integer",
              "minimum": 0
            },
            "complete": {
              "type": "boolean"
            },
            "window_start": {
              "type": "string",
              "format": "date"
            },
            "window_end": {
              "type": "string",
              "format": "date"
            },
            "semantics": {
              "const": "distinct_xnys_sessions_no_early_evaluation"
            }
          },
          "additionalProperties": false
        },
        "substitution_allowed": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "blockers": {
      "$ref": "#/$defs/string_list"
    },
    "gaps": {
      "$ref": "#/$defs/string_list"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "owner",
          "next_action"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "object",
      "required": [
        "report",
        "manifest"
      ],
      "properties": {
        "report": {
          "$ref": "#/$defs/posix_path"
        },
        "manifest": {
          "$ref": "#/$defs/posix_path"
        }
      },
      "additionalProperties": false
    },
    "guardrails": {
      "type": "object",
      "required": [
        "candidate_frozen",
        "parameters_may_change",
        "candidate_reselection_allowed",
        "backfill_allowed",
        "network_used",
        "secret_accessed",
        "promotion_allowed",
        "paper_allowed",
        "paper_runner_allowed",
        "paper_runner_started",
        "paper_queue_write_allowed",
        "live_allowed",
        "live_order_allowed",
        "private_endpoint_allowed",
        "order_endpoint_allowed",
        "broker_access_allowed",
        "broker_calls_used",
        "withdraw_allowed",
        "demo_allowed",
        "real_order_submitted",
        "scheduler_modified",
        "data_manifest_written"
      ],
      "properties": {
        "candidate_frozen": {
          "const": true
        },
        "parameters_may_change": {
          "const": false
        },
        "candidate_reselection_allowed": {
          "const": false
        },
        "backfill_allowed": {
          "const": false
        },
        "network_used": {
          "const": false
        },
        "secret_accessed": {
          "const": false
        },
        "promotion_allowed": {
          "const": false
        },
        "paper_allowed": {
          "const": false
        },
        "paper_runner_allowed": {
          "const": false
        },
        "paper_runner_started": {
          "const": false
        },
        "paper_queue_write_allowed": {
          "const": false
        },
        "live_allowed": {
          "const": false
        },
        "live_order_allowed": {
          "const": false
        },
        "private_endpoint_allowed": {
          "const": false
        },
        "order_endpoint_allowed": {
          "const": false
        },
        "broker_access_allowed": {
          "const": false
        },
        "broker_calls_used": {
          "const": false
        },
        "withdraw_allowed": {
          "const": false
        },
        "demo_allowed": {
          "const": false
        },
        "real_order_submitted": {
          "const": false
        },
        "scheduler_modified": {
          "const": false
        },
        "data_manifest_written": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "artifact_identity_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "string_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "posix_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\]+$"
    },
    "state": {
      "type": "object",
      "required": [
        "status",
        "session",
        "source_head",
        "artifact_path",
        "sha256",
        "verified",
        "simulation_scope"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "source_head": {
          "$ref": "#/$defs/commit"
        },
        "artifact_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^$|^[0-9a-f]{64}$"
        },
        "verified": {
          "type": "boolean"
        },
        "simulation_scope": {
          "const": "research_fixture_or_local_replay_only"
        }
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "required": [
        "required",
        "observed",
        "complete",
        "semantics"
      ],
      "properties": {
        "required": {
          "type": "integer"
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "semantics": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
