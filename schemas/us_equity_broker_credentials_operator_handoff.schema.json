{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_broker_credentials_operator_handoff.schema.json",
  "title": "QuantStation VNEXT US Equity Broker Credentials Operator Handoff",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "asset",
    "status",
    "allowed_statuses",
    "review_report",
    "operator_files",
    "manual_review_readiness",
    "broker_connectivity_evidence",
    "operator_checklist",
    "operator_next_actions",
    "acceptance_evidence",
    "blockers",
    "guardrails",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_broker_credentials_operator_handoff_v1"},
    "generated_at": {"type": "string", "minLength": 1},
    "asset": {"const": "us_equity"},
    "status": {
      "enum": [
        "broker_credentials_handoff_blocked",
        "broker_credentials_handoff_ready_for_manual_review"
      ]
    },
    "allowed_statuses": {
      "type": "array",
      "items": {
        "enum": [
          "broker_credentials_handoff_blocked",
          "broker_credentials_handoff_ready_for_manual_review"
        ]
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "review_report": {"type": "object"},
    "operator_files": {
      "type": "object",
      "required": ["template", "template_exists", "local_review", "local_review_exists", "local_review_should_not_be_committed"],
      "properties": {
        "template": {"type": "string", "minLength": 1},
        "template_exists": {"type": "boolean"},
        "local_review": {"type": "string", "minLength": 1},
        "local_review_exists": {"type": "boolean"},
        "local_review_should_not_be_committed": {"const": true}
      },
      "additionalProperties": false
    },
    "manual_review_readiness": {
      "type": "object",
      "required": [
        "review_report_exists",
        "review_report_status",
        "template_exists",
        "template_safe_defaults_present",
        "local_review_exists",
        "local_review_gitignored",
        "missing_manual_fields",
        "unsafe_boolean_fields",
        "ready_for_manual_review",
        "review_proven",
        "paper_or_live_unlock_allowed",
        "live_order_allowed"
      ],
      "properties": {
        "review_report_exists": {"type": "boolean"},
        "review_report_status": {"type": "string"},
        "template_exists": {"type": "boolean"},
        "template_safe_defaults_present": {"type": "boolean"},
        "local_review_exists": {"type": "boolean"},
        "local_review_gitignored": {"type": "boolean"},
        "missing_manual_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unsafe_boolean_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ready_for_manual_review": {"type": "boolean"},
        "review_proven": {"type": "boolean"},
        "paper_or_live_unlock_allowed": {"const": false},
        "live_order_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "broker_connectivity_evidence": {
      "type": "object",
      "required": [
        "evidence_role",
        "probe_report",
        "coverage_report",
        "operator_interpretation",
        "guardrails"
      ],
      "properties": {
        "evidence_role": {"const": "read_only_ibkr_market_data_connectivity_only"},
        "probe_report": {
          "type": "object",
          "required": ["path", "exists", "status", "readonly_connection_requested", "summary", "blockers"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "exists": {"type": "boolean"},
            "status": {"type": "string"},
            "host": {"type": "string"},
            "port": {},
            "client_id": {},
            "readonly_connection_requested": {"type": "boolean"},
            "symbols": {"type": "array", "items": {"type": "string"}},
            "summary": {"type": "object"},
            "blockers": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "coverage_report": {
          "type": "object",
          "required": ["path", "exists", "status", "research_ready_status", "summary", "blockers"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "exists": {"type": "boolean"},
            "status": {"type": "string"},
            "research_ready_status": {"type": "string"},
            "summary": {"type": "object"},
            "blockers": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "operator_interpretation": {
          "type": "object",
          "required": [
            "connection_proven",
            "market_data_probe_passed",
            "minute_coverage_complete",
            "minute_data_research_ready",
            "can_satisfy_credential_review",
            "can_unlock_paper_or_live",
            "manual_review_still_required",
            "note"
          ],
          "properties": {
            "connection_proven": {"type": "boolean"},
            "market_data_probe_passed": {"type": "boolean"},
            "minute_coverage_complete": {"type": "boolean"},
            "minute_data_research_ready": {"type": "boolean"},
            "can_satisfy_credential_review": {"const": false},
            "can_unlock_paper_or_live": {"const": false},
            "manual_review_still_required": {"const": true},
            "note": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "guardrails": {
          "type": "object",
          "required": [
            "market_data_probe_only",
            "private_account_endpoint_used",
            "order_endpoint_used",
            "broker_order_endpoint_used",
            "real_order_submitted",
            "paper_or_live_unlock_allowed",
            "live_order_allowed"
          ],
          "properties": {
            "market_data_probe_only": {"const": true},
            "private_account_endpoint_used": {"const": false},
            "order_endpoint_used": {"const": false},
            "broker_order_endpoint_used": {"const": false},
            "real_order_submitted": {"const": false},
            "coverage_network_called": {"type": "boolean"},
            "paper_or_live_unlock_allowed": {"const": false},
            "live_order_allowed": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "operator_checklist": {"type": "array", "minItems": 1},
    "operator_next_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "guardrails": {
      "type": "object",
      "required": [
        "operator_handoff_only",
        "contains_secret_values",
        "secret_values_must_not_be_written",
        "local_review_should_not_be_committed",
        "paper_or_live_unlock_allowed",
        "paper_simulation_allowed",
        "live_order_allowed",
        "private_endpoint_allowed",
        "order_endpoint_allowed",
        "broker_calls_used",
        "real_order_submitted"
      ],
      "properties": {
        "operator_handoff_only": {"const": true},
        "contains_secret_values": {"const": false},
        "secret_values_must_not_be_written": {"const": true},
        "local_review_should_not_be_committed": {"const": true},
        "paper_or_live_unlock_allowed": {"const": false},
        "paper_simulation_allowed": {"const": false},
        "live_order_allowed": {"const": false},
        "private_endpoint_allowed": {"const": false},
        "order_endpoint_allowed": {"const": false},
        "broker_calls_used": {"const": false},
        "real_order_submitted": {"const": false}
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["json", "markdown"],
      "properties": {
        "json": {"type": "string", "minLength": 1},
        "markdown": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
