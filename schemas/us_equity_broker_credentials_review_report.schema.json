{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_broker_credentials_review_report.schema.json",
  "title": "QuantStation VNEXT US Equity Broker Credentials Review Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "asset",
    "status",
    "broker_credentials_proven",
    "allowed_statuses",
    "credential_review",
    "review_input",
    "local_review_write_policy",
    "template_safety",
    "review_metadata",
    "review_summary",
    "secret_scan",
    "operator_checklist",
    "operator_review_guidance",
    "evidence_classification",
    "blockers",
    "paper_order_allowed",
    "live_order_allowed",
    "guardrails",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_broker_credentials_review_v1"},
    "generated_at": {"type": "string", "minLength": 1},
    "asset": {"const": "us_equity"},
    "status": {"enum": ["broker_credentials_review_blocked", "broker_credentials_review_proven"]},
    "broker_credentials_proven": {"type": "boolean"},
    "allowed_statuses": {
      "type": "array",
      "items": {"enum": ["broker_credentials_review_blocked", "broker_credentials_review_proven"]},
      "minItems": 2,
      "uniqueItems": true
    },
    "credential_review": {
      "type": "object",
      "required": [
        "metadata_only",
        "broker_name",
        "account_id_hash",
        "account_id_hash_recorded",
        "reviewer",
        "reviewed_at",
        "manual_approval_ticket",
        "funding_source_external_confirmation",
        "credential_storage",
        "secret_values_recorded",
        "raw_account_id_recorded",
        "raw_funding_source_recorded",
        "can_unlock_paper_or_live"
      ],
      "properties": {
        "metadata_only": {"const": true},
        "broker_name": {"type": "string"},
        "account_id_hash": {"type": "string"},
        "account_id_hash_recorded": {"type": "boolean"},
        "reviewer": {"type": "string"},
        "reviewed_at": {"type": "string"},
        "manual_approval_ticket": {"type": "string"},
        "funding_source_external_confirmation": {"type": "boolean"},
        "credential_storage": {"type": "string"},
        "secret_values_recorded": {"const": false},
        "raw_account_id_recorded": {"const": false},
        "raw_funding_source_recorded": {"const": false},
        "can_unlock_paper_or_live": {"const": false}
      },
      "additionalProperties": false
    },
    "review_input": {
      "type": "object",
      "required": ["path", "exists", "template_path", "template_exists"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "exists": {"type": "boolean"},
        "template_path": {"type": "string", "minLength": 1},
        "template_exists": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "local_review_write_policy": {
      "type": "object",
      "required": [
        "local_review_path",
        "should_not_commit_local_review",
        "local_review_gitignore_present",
        "allowed_template_path",
        "secret_values_must_not_be_written",
        "broker_calls_used",
        "private_endpoint_allowed",
        "order_endpoint_allowed",
        "real_order_submitted"
      ],
      "properties": {
        "local_review_path": {"const": "configs/execution/us_equity_broker_credentials_review.local.json"},
        "should_not_commit_local_review": {"const": true},
        "local_review_gitignore_present": {"type": "boolean"},
        "allowed_template_path": {"const": "configs/execution/us_equity_broker_credentials_review.template.json"},
        "secret_values_must_not_be_written": {"const": true},
        "broker_calls_used": {"const": false},
        "private_endpoint_allowed": {"const": false},
        "order_endpoint_allowed": {"const": false},
        "real_order_submitted": {"const": false}
      },
      "additionalProperties": false
    },
    "review_metadata": {
      "type": "object",
      "required": [
        "metadata_only",
        "status",
        "reviewer",
        "reviewed_at",
        "broker_name",
        "account_id_hash",
        "account_id_hash_recorded",
        "manual_approval_ticket",
        "funding_source_recorded_outside_repo",
        "credential_storage",
        "secret_values_recorded",
        "raw_account_id_recorded",
        "raw_funding_source_recorded",
        "can_unlock_paper_or_live"
      ],
      "properties": {
        "metadata_only": {"const": true},
        "status": {"enum": ["broker_credentials_review_blocked", "broker_credentials_review_proven"]},
        "reviewer": {"type": "string"},
        "reviewed_at": {"type": "string"},
        "broker_name": {"type": "string"},
        "account_id_hash": {"type": "string"},
        "account_id_hash_recorded": {"type": "boolean"},
        "manual_approval_ticket": {"type": "string"},
        "funding_source_recorded_outside_repo": {"type": "boolean"},
        "credential_storage": {"type": "string"},
        "secret_values_recorded": {"const": false},
        "raw_account_id_recorded": {"const": false},
        "raw_funding_source_recorded": {"const": false},
        "can_unlock_paper_or_live": {"const": false}
      },
      "additionalProperties": false
    },
    "review_summary": {
      "type": "object",
      "required": [
        "reviewer_recorded",
        "reviewed_at_recorded",
        "broker_name_recorded",
        "account_id_hash_recorded",
        "account_id_hash_format",
        "account_id_hash_format_ok",
        "raw_account_id_pattern_detected",
        "credential_storage",
        "api_key_present_in_repo",
        "secret_values_logged",
        "read_only_or_live_disabled",
        "order_permission_enabled",
        "private_endpoint_test_used",
        "order_endpoint_test_used",
        "funding_source_recorded_outside_repo",
        "manual_approval_ticket_recorded",
        "secret_like_field_count"
      ],
      "properties": {
        "reviewer_recorded": {"type": "boolean"},
        "reviewed_at_recorded": {"type": "boolean"},
        "broker_name_recorded": {"type": "boolean"},
        "account_id_hash_recorded": {"type": "boolean"},
        "account_id_hash_format": {"enum": ["missing", "sha256_hex_64", "raw_account_id_like", "invalid"]},
        "account_id_hash_format_ok": {"type": "boolean"},
        "raw_account_id_pattern_detected": {"type": "boolean"},
        "credential_storage": {"type": "string"},
        "api_key_present_in_repo": {"type": ["boolean", "null"]},
        "secret_values_logged": {"type": ["boolean", "null"]},
        "read_only_or_live_disabled": {"type": ["boolean", "null"]},
        "order_permission_enabled": {"type": ["boolean", "null"]},
        "private_endpoint_test_used": {"type": ["boolean", "null"]},
        "order_endpoint_test_used": {"type": ["boolean", "null"]},
        "funding_source_recorded_outside_repo": {"type": ["boolean", "null"]},
        "manual_approval_ticket_recorded": {"type": "boolean"},
        "secret_like_field_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "template_safety": {
      "type": "object",
      "required": [
        "template_exists",
        "template_schema_ok",
        "safe_defaults_present",
        "read_only_or_live_disabled_default",
        "order_permission_enabled_default",
        "secret_defaults_safe",
        "secret_like_fields"
      ],
      "properties": {
        "template_exists": {"type": "boolean"},
        "template_schema_ok": {"type": "boolean"},
        "safe_defaults_present": {"type": "boolean"},
        "read_only_or_live_disabled_default": {"type": ["boolean", "null"]},
        "order_permission_enabled_default": {"type": ["boolean", "null"]},
        "secret_defaults_safe": {"type": "boolean"},
        "secret_like_fields": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "secret_scan": {
      "type": "object",
      "required": [
        "metadata_only_scan",
        "forbidden_field_paths",
        "template_forbidden_field_paths",
        "secret_like_field_count",
        "template_secret_like_field_count",
        "raw_account_id_pattern_detected",
        "contains_secret_values",
        "secret_values_exposed_in_artifact",
        "raw_account_id_exposed_in_artifact",
        "raw_funding_source_exposed_in_artifact"
      ],
      "properties": {
        "metadata_only_scan": {"const": true},
        "forbidden_field_paths": {"type": "array", "items": {"type": "string"}},
        "template_forbidden_field_paths": {"type": "array", "items": {"type": "string"}},
        "secret_like_field_count": {"type": "integer", "minimum": 0},
        "template_secret_like_field_count": {"type": "integer", "minimum": 0},
        "raw_account_id_pattern_detected": {"type": "boolean"},
        "contains_secret_values": {"const": false},
        "secret_values_exposed_in_artifact": {"const": false},
        "raw_account_id_exposed_in_artifact": {"const": false},
        "raw_funding_source_exposed_in_artifact": {"const": false}
      },
      "additionalProperties": false
    },
    "operator_checklist": {
      "type": "object",
      "required": [
        "status",
        "metadata_items",
        "safety_items",
        "paper_or_live_unlock_allowed",
        "live_order_allowed"
      ],
      "properties": {
        "status": {"enum": ["review_checklist_incomplete", "review_checklist_complete"]},
        "metadata_items": {
          "type": "array",
          "minItems": 6,
          "items": {"$ref": "#/$defs/checklist_item"}
        },
        "safety_items": {
          "type": "array",
          "minItems": 10,
          "items": {"$ref": "#/$defs/checklist_item"}
        },
        "paper_or_live_unlock_allowed": {"const": false},
        "live_order_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "operator_review_guidance": {
      "type": "object",
      "required": [
        "status",
        "local_review_path",
        "template_path",
        "missing_required_fields",
        "required_boolean_controls",
        "forbidden_field_paths",
        "account_id_hash_instruction",
        "secret_handling_instruction",
        "operator_next_actions"
      ],
      "properties": {
        "status": {"enum": ["manual_review_required", "review_complete"]},
        "local_review_path": {"const": "configs/execution/us_equity_broker_credentials_review.local.json"},
        "template_path": {"const": "configs/execution/us_equity_broker_credentials_review.template.json"},
        "missing_required_fields": {
          "type": "array",
          "items": {
            "enum": ["reviewer", "reviewed_at", "broker_name", "account_id_hash", "manual_approval_ticket"]
          },
          "uniqueItems": true
        },
        "required_boolean_controls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "required_value"],
            "properties": {
              "field": {
                "enum": [
                  "api_key_present_in_repo",
                  "secret_values_logged",
                  "read_only_or_live_disabled",
                  "order_permission_enabled",
                  "private_endpoint_test_used",
                  "order_endpoint_test_used",
                  "funding_source_recorded_outside_repo"
                ]
              },
              "required_value": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "forbidden_field_paths": {"type": "array", "items": {"type": "string"}},
        "account_id_hash_instruction": {"type": "string", "minLength": 1},
        "secret_handling_instruction": {"type": "string", "minLength": 1},
        "operator_next_actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "evidence_classification": {
      "type": "object",
      "required": [
        "classification",
        "status",
        "contains_secret_values",
        "contains_account_number",
        "contains_raw_funding_source",
        "broker_calls_used",
        "private_endpoint_used",
        "order_endpoint_used",
        "can_unlock_paper_or_live"
      ],
      "properties": {
        "classification": {"const": "manual_review_metadata_only"},
        "status": {"enum": ["broker_credentials_review_blocked", "broker_credentials_review_proven"]},
        "contains_secret_values": {"const": false},
        "contains_account_number": {"const": false},
        "contains_raw_funding_source": {"const": false},
        "broker_calls_used": {"const": false},
        "private_endpoint_used": {"const": false},
        "order_endpoint_used": {"const": false},
        "can_unlock_paper_or_live": {"const": false}
      },
      "additionalProperties": false
    },
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "paper_order_allowed": {"const": false},
    "live_order_allowed": {"const": false},
    "guardrails": {
      "type": "object",
      "required": [
        "review_only",
        "no_secret_values_allowed",
        "paper_or_live_unlock_allowed",
        "paper_simulation_allowed",
        "live_order_allowed",
        "private_endpoint_allowed",
        "order_endpoint_allowed",
        "broker_calls_used",
        "real_order_submitted"
      ],
      "properties": {
        "review_only": {"const": true},
        "no_secret_values_allowed": {"const": true},
        "paper_or_live_unlock_allowed": {"const": false},
        "paper_simulation_allowed": {"const": false},
        "live_order_allowed": {"const": false},
        "private_endpoint_allowed": {"const": false},
        "order_endpoint_allowed": {"const": false},
        "broker_calls_used": {"const": false},
        "real_order_submitted": {"const": false}
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["json", "markdown"],
      "properties": {
        "json": {"type": "string", "minLength": 1},
        "markdown": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "broker_credentials_review_proven"}}, "required": ["status"]},
      "then": {
        "properties": {
          "broker_credentials_proven": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "broker_credentials_review_blocked"}}, "required": ["status"]},
      "then": {
        "properties": {
          "broker_credentials_proven": {"const": false}
        }
      }
    }
  ],
  "$defs": {
    "checklist_item": {
      "type": "object",
      "required": ["item_id", "passed"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
