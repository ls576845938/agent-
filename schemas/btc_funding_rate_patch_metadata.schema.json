{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/btc_funding_rate_patch_metadata.schema.json",
  "title": "QuantStation VNEXT BTC Funding Rate Patch Metadata",
  "type": "object",
  "required": [
    "schema_version",
    "patch_id",
    "csv_filename",
    "csv_sha256",
    "source_method",
    "source_base_url",
    "source_endpoint",
    "symbol",
    "requested_start",
    "requested_end",
    "startTime",
    "endTime",
    "captured_at",
    "operator_note",
    "api_key_used",
    "private_endpoint_used",
    "auth_headers_present",
    "record_count",
    "expected_row_count",
    "expected_first_fundingTime",
    "expected_last_fundingTime",
    "funding_interval_hours",
    "target_bundle_id",
    "target_file",
    "merge_key",
    "merge_policy",
    "requests",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "btc_funding_rate_patch_metadata_v1"},
    "patch_id": {"type": "string"},
    "csv_filename": {"type": "string"},
    "csv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_method": {"const": "manual_offline_public_rest_capture"},
    "source_base_url": {"const": "https://fapi.binance.com"},
    "source_endpoint": {"const": "/fapi/v1/fundingRate"},
    "symbol": {"const": "BTCUSDT"},
    "requested_start": {"type": "string"},
    "requested_end": {"type": "string"},
    "startTime": {"type": "integer"},
    "endTime": {"type": "integer"},
    "captured_at": {"type": "string"},
    "operator_note": {"type": "string", "minLength": 1},
    "api_key_used": {"const": false},
    "private_endpoint_used": {"const": false},
    "auth_headers_present": {"const": false},
    "record_count": {"type": "integer", "minimum": 1},
    "expected_row_count": {"type": "integer", "minimum": 1},
    "expected_first_fundingTime": {"type": "integer"},
    "expected_last_fundingTime": {"type": "integer"},
    "funding_interval_hours": {"type": "number"},
    "target_bundle_id": {"type": "string"},
    "target_file": {"const": "funding_rate.csv"},
    "merge_key": {"const": "fundingTime"},
    "merge_policy": {"const": "fail_on_duplicate_fundingTime"},
    "operator": {"type": ["string", "null"]},
    "created_at": {"type": ["string", "null"]},
    "requests": {"type": "array"},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
