{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_survivorship_audit_report.schema.json",
  "title": "QuantStation VNEXT US Equity Survivorship Audit Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "universe_version",
    "sample_start",
    "sample_end",
    "symbol_count",
    "delisted_symbols_included",
    "historical_membership_available",
    "membership_event_count",
    "delisting_event_count",
    "survivorship_status",
    "survivorship_risk",
    "promotion_clean",
    "selected_provider",
    "provider_verification_report_path",
    "provider_verified_for_promotion",
    "identifier_mapping_available",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_survivorship_audit_report_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "universe_version": {"type": "string"},
    "sample_start": {"type": "string"},
    "sample_end": {"type": "string"},
    "symbol_count": {"type": "integer", "minimum": 0},
    "delisted_symbols_included": {"type": "boolean"},
    "historical_membership_available": {"type": "boolean"},
    "membership_event_count": {"type": "integer", "minimum": 0},
    "delisting_event_count": {"type": "integer", "minimum": 0},
    "survivorship_status": {"enum": ["unknown", "not_clean", "partially_controlled", "clean"]},
    "survivorship_risk": {"enum": ["unknown", "likely", "medium", "low"]},
    "promotion_clean": {"type": "boolean"},
    "selected_provider": {"enum": ["yfinance", "local_csv", "crsp", "sharadar", "polygon", "norgate", "none"]},
    "provider_verification_report_path": {"type": "string"},
    "provider_verified_for_promotion": {"type": "boolean"},
    "identifier_mapping_available": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
