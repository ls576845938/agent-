{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_broker_credentials_local_review_init_report.schema.json",
  "title": "QuantStation VNEXT US Equity Broker Credentials Local Review Init Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "asset",
    "status",
    "allowed_statuses",
    "template",
    "local_review",
    "local_review_exists_after",
    "actions",
    "blockers",
    "operator_next_actions",
    "guardrails"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_broker_credentials_local_review_init_v1"},
    "generated_at": {"type": "string", "minLength": 1},
    "asset": {"const": "us_equity"},
    "status": {
      "enum": [
        "local_review_init_blocked",
        "local_review_initialized"
      ]
    },
    "allowed_statuses": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "local_review_init_blocked",
          "local_review_initialized"
        ]
      }
    },
    "template": {"type": "string", "minLength": 1},
    "local_review": {"type": "string", "minLength": 1},
    "local_review_exists_after": {"type": "boolean"},
    "actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "operator_next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "guardrails": {
      "type": "object",
      "required": [
        "local_template_init_only",
        "contains_secret_values",
        "secret_values_must_not_be_written",
        "local_review_should_not_be_committed",
        "paper_or_live_unlock_allowed",
        "paper_simulation_allowed",
        "live_order_allowed",
        "private_endpoint_allowed",
        "order_endpoint_allowed",
        "broker_calls_used",
        "real_order_submitted"
      ],
      "properties": {
        "local_template_init_only": {"const": true},
        "contains_secret_values": {"const": false},
        "secret_values_must_not_be_written": {"const": true},
        "local_review_should_not_be_committed": {"const": true},
        "paper_or_live_unlock_allowed": {"const": false},
        "paper_simulation_allowed": {"const": false},
        "live_order_allowed": {"const": false},
        "private_endpoint_allowed": {"const": false},
        "order_endpoint_allowed": {"const": false},
        "broker_calls_used": {"const": false},
        "real_order_submitted": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
