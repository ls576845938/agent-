{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_provider_verification_report.schema.json",
  "title": "QuantStation VNEXT US Equity Provider Verification Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "selected_provider",
    "provider_id",
    "source_type",
    "source_provider",
    "bundle_id",
    "bundle_manifest_path",
    "bundle_hash",
    "license_note",
    "promotion_clean_allowed",
    "production_bundle_preflight_report_path",
    "production_bundle_preflight_pass",
    "selected_bundle_id",
    "selected_bundle_source_type",
    "selected_bundle_manifest_path",
    "explicit_bundle_selection_confirmed",
    "promotion_clean_allowed_by_config",
    "promotion_clean_allowed_by_manifest",
    "active_bundle_validation_status",
    "provider_config_path",
    "local_data_available",
    "required_tables_available",
    "required_fields_available",
    "record_count",
    "date_range",
    "sample_validation_pass",
    "point_in_time_universe_confirmed",
    "delisting_coverage_confirmed",
    "corporate_action_event_source_available",
    "identifier_mapping_available",
    "adjustment_reproducibility_confirmed",
    "survivorship_clean",
    "promotion_clean",
    "data_lineage_grade_candidate",
    "bundle_record_count_by_table",
    "bundle_date_range_by_table",
    "verified_artifacts",
    "bundle_validation",
    "structural_validation",
    "pit_validation",
    "survivorship_validation",
    "corporate_action_validation",
    "adjustment_replay_validation",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_provider_verification_report_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "selected_provider": {"enum": ["yfinance", "local_csv", "crsp", "sharadar", "polygon", "norgate", "none"]},
    "provider_id": {"type": "string"},
    "source_type": {"enum": ["fixture", "sample", "production", "research_price_bars", "none"]},
    "source_provider": {"type": ["string", "null"]},
    "bundle_id": {"type": ["string", "null"]},
    "bundle_manifest_path": {"type": ["string", "null"]},
    "bundle_hash": {"type": ["string", "null"]},
    "license_note": {"type": ["string", "null"]},
    "promotion_clean_allowed": {"type": "boolean"},
    "production_bundle_preflight_report_path": {"type": ["string", "null"]},
    "production_bundle_preflight_pass": {"type": "boolean"},
    "selected_bundle_id": {"type": ["string", "null"]},
    "selected_bundle_source_type": {"enum": ["fixture", "sample", "production", "research_price_bars", "none", "unknown", null]},
    "selected_bundle_manifest_path": {"type": ["string", "null"]},
    "explicit_bundle_selection_confirmed": {"type": "boolean"},
    "promotion_clean_allowed_by_config": {"type": "boolean"},
    "promotion_clean_allowed_by_manifest": {"type": "boolean"},
    "active_bundle_validation_status": {"enum": ["pass", "fail", "not_applicable"]},
    "provider_config_path": {"type": "string"},
    "local_data_available": {"type": "boolean"},
    "required_tables_available": {"type": "boolean"},
    "required_fields_available": {"type": "boolean"},
    "record_count": {"type": "integer", "minimum": 0},
    "date_range": {"$ref": "#/$defs/dateRange"},
    "sample_validation_pass": {"type": "boolean"},
    "point_in_time_universe_confirmed": {"type": "boolean"},
    "delisting_coverage_confirmed": {"type": "boolean"},
    "corporate_action_event_source_available": {"type": "boolean"},
    "identifier_mapping_available": {"type": "boolean"},
    "adjustment_reproducibility_confirmed": {"type": "boolean"},
    "survivorship_clean": {"type": "boolean"},
    "promotion_clean": {"type": "boolean"},
    "data_lineage_grade_candidate": {
      "enum": ["L0_fixture", "L1_sample_non_pit", "L2_static_snapshot", "L3_point_in_time_universe", "L4_promotion_clean"]
    },
    "bundle_record_count_by_table": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "bundle_date_range_by_table": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/dateRange"}
    },
    "verified_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "bundle_validation": {"type": "object"},
    "structural_validation": {"type": "object"},
    "pit_validation": {"type": "object"},
    "survivorship_validation": {"type": "object"},
    "corporate_action_validation": {"type": "object"},
    "adjustment_replay_validation": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "dateRange": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": ["string", "null"]},
        "end": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
