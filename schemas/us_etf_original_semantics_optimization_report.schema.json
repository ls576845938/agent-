{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_etf_original_semantics_optimization_report.schema.json",
  "title": "QuantStation VNEXT US ETF Original Semantics Optimization Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "live_ready",
    "paper_ready",
    "baseline_id",
    "rebalance_semantics",
    "data_lake",
    "benchmarks",
    "baseline",
    "candidate_count",
    "all_candidates",
    "ranking",
    "highest_cagr_candidate",
    "best_value_candidate",
    "decision",
    "methodology"
  ],
  "properties": {
    "schema_version": {"const": "us_etf_original_semantics_optimization_report_v1"},
    "generated_at": {"type": "string", "minLength": 1},
    "status": {"const": "research_only_original_semantics"},
    "live_ready": {"const": false},
    "paper_ready": {"const": false},
    "baseline_id": {"const": "original_v8_2_semantics"},
    "rebalance_semantics": {"const": "calendar_month_end_only_skip_if_not_trading_day"},
    "data_lake": {"type": "string", "minLength": 1},
    "benchmarks": {"type": "object", "required": ["SPY", "QQQ"], "additionalProperties": {"type": "object"}},
    "baseline": {"$ref": "#/$defs/candidate"},
    "candidate_count": {"type": "integer", "minimum": 8},
    "all_candidates": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/candidate"}},
    "ranking": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/candidate"}},
    "highest_cagr_candidate": {"$ref": "#/$defs/candidate"},
    "best_value_candidate": {"$ref": "#/$defs/candidate"},
    "decision": {
      "type": "object",
      "required": [
        "status",
        "live_ready",
        "paper_ready",
        "highest_cagr_candidate_id",
        "best_value_candidate_id",
        "highest_cagr_improvement_vs_original",
        "reason"
      ],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "live_ready": {"const": false},
        "paper_ready": {"const": false},
        "highest_cagr_candidate_id": {"type": "string", "minLength": 1},
        "best_value_candidate_id": {"type": "string", "minLength": 1},
        "highest_cagr_improvement_vs_original": {"type": "number"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "methodology": {
      "type": "object",
      "required": ["allowed_changes", "forbidden_changes"],
      "properties": {
        "allowed_changes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "forbidden_changes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "description",
        "parameters",
        "metrics",
        "excess_vs_original",
        "beats_spy_cagr",
        "beats_qqq_cagr"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "metrics": {"$ref": "#/$defs/metrics"},
        "excess_vs_original": {"type": ["number", "object"]},
        "beats_spy_cagr": {"type": "boolean"},
        "beats_qqq_cagr": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["strategy", "SPY", "QQQ", "turnover", "rows", "sample_start", "sample_end"],
      "properties": {
        "strategy": {"$ref": "#/$defs/performance"},
        "SPY": {"$ref": "#/$defs/performance"},
        "QQQ": {"$ref": "#/$defs/performance"},
        "turnover": {"type": "number", "minimum": 0},
        "rows": {"type": "integer", "minimum": 1},
        "sample_start": {"type": "string", "minLength": 1},
        "sample_end": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "required": ["true_cagr", "total_return", "max_drawdown", "sharpe_no_risk_free"],
      "properties": {
        "true_cagr": {"type": "number"},
        "arithmetic_annualized_return": {"type": "number"},
        "total_return": {"type": "number"},
        "max_drawdown": {"type": "number"},
        "sharpe_no_risk_free": {"type": "number"}
      },
      "additionalProperties": false
    }
  }
}
