          "enum": ["manual_capture_from_allowed_network", "capture_public_fee_schedule_and_import", "none"]
        },
        "blockers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "feeTierPacketStatus": {
      "type": "object",
      "required": [
        "cost_model_report",
        "cost_model_status",
        "fee_tier_verified",
        "manual_capture_required",
        "maker_fee_bps",
        "taker_fee_bps",
        "fee_tier_import_report_verified",
        "fee_blockers"
      ],
      "properties": {
        "cost_model_report": {"type": ["string", "null"]},
        "cost_model_status": {"type": "string"},
        "fee_tier_verified": {"type": "boolean"},
        "manual_capture_required": {"type": "boolean"},
        "maker_fee_bps": {"type": ["number", "null"], "minimum": 0},
        "taker_fee_bps": {"type": ["number", "null"], "minimum": 0},
        "fee_tier_import_report_verified": {"type": "boolean"},
        "fee_blockers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "manualMetadataImportStatus": {
      "type": "object",
      "required": [
        "status",
        "report_path",
        "dry_run",
        "captured_at",
        "bundle_dir",
        "bundle_dir_exists",
        "bundle_dir_matches_selected",
        "bundle_exchange_info_exists",
        "bundle_funding_info_exists",
        "bundle_exchange_info_output_hash_verified",
        "bundle_funding_info_output_hash_verified",
        "writes_performed",
        "exchange_info_verified",
        "funding_info_verified",
        "valid_for_completion",
        "raw_input_files",
        "post_import_validation_command",
        "blockers"
      ],
      "properties": {
        "status": {"type": "string"},
        "report_path": {"type": ["string", "null"]},
        "dry_run": {"type": "boolean"},
        "captured_at": {"type": ["string", "null"]},
        "bundle_dir": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "\\S"}
          ]
        },
        "bundle_dir_exists": {"type": "boolean"},
        "bundle_dir_matches_selected": {"type": "boolean"},
        "bundle_exchange_info_exists": {"type": "boolean"},
        "bundle_funding_info_exists": {"type": "boolean"},
        "bundle_exchange_info_output_hash_verified": {"type": "boolean"},
        "bundle_funding_info_output_hash_verified": {"type": "boolean"},
        "writes_performed": {"type": "boolean"},
        "exchange_info_verified": {"type": "boolean"},
        "funding_info_verified": {"type": "boolean"},
        "valid_for_completion": {"type": "boolean"},
        "raw_input_files": {
          "type": "object",
          "required": ["exchange_info_raw", "funding_info_raw"],
          "properties": {
            "exchange_info_raw": {"$ref": "#/$defs/rawInputFileStatus"},
            "funding_info_raw": {"$ref": "#/$defs/rawInputFileStatus"}
          },
          "additionalProperties": false
        },
        "post_import_validation_command": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "\\S"}
          ]
        },
        "blockers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "objectiveCompletionStatus": {
      "type": "object",
      "required": [
        "status",
        "goal_complete",
        "complete_requirements",
        "incomplete_requirements",
        "next_required_action",
        "blockers"
      ],
      "properties": {
        "status": {"type": "string"},
        "goal_complete": {"type": "boolean"},
        "complete_requirements": {"type": "array", "items": {"type": "string"}},
        "incomplete_requirements": {"type": "array", "items": {"type": "string"}},
        "next_required_action": {"type": "string"},
        "blockers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "rawInputFileStatus": {
      "type": "object",
      "required": ["path", "exists", "size_bytes", "sha256", "http_status_file", "http_status", "http_status_verified"],
      "properties": {
        "path": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "\\S"}
          ]
        },
        "exists": {"type": "boolean"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "http_status_file": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "\\S"}
          ]
        },
        "http_status": {"type": ["integer", "null"]},
        "http_status_verified": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
