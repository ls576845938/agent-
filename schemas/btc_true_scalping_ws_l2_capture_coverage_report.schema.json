{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/btc_true_scalping_ws_l2_capture_coverage_report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "asset",
    "symbol",
    "venue_symbol",
    "scope",
    "status",
    "decision",
    "next_required_action",
    "thresholds",
    "capture_root",
    "sessions",
    "coverage_totals",
    "validation",
    "blockers",
    "coverage_contract_satisfied",
    "contract_satisfied",
    "event_ledger_feature_validation_allowed",
    "execution_latency_model_ready",
    "queue_model_ready",
    "true_scalping_allowed",
    "candidate_generation_allowed",
    "strategy_skeleton_generation_allowed",
    "promotion_allowed",
    "paper_review_pending_allowed",
    "paper_or_live_unlock_allowed",
    "guardrails"
  ],
  "properties": {
    "schema_version": {"const": "btc_true_scalping_ws_l2_capture_coverage_report_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "asset": {"const": "btc"},
    "symbol": {"const": "BTCUSDT"},
    "venue_symbol": {"const": "BTC-USDT-SWAP"},
    "scope": {"const": "research_only_ws_l2_capture_coverage_no_candidate_no_paper_no_live"},
    "status": {
      "enum": [
        "ws_l2_capture_coverage_accumulating_research_only_history_insufficient",
        "ws_l2_capture_coverage_thresholds_met_research_only_execution_queue_locked",
        "ws_l2_capture_coverage_missing_or_invalid_research_only"
      ]
    },
    "decision": {"const": "continue_accumulating_public_ws_l2_history_before_true_scalping"},
    "next_required_action": {"type": "string"},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_research_capture_seconds", "minimum_event_ledger_history_days", "required_channels"],
      "properties": {
        "minimum_research_capture_seconds": {"type": "number", "minimum": 3600},
        "minimum_event_ledger_history_days": {"type": "number", "minimum": 30},
        "required_channels": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string"}
        }
      }
    },
    "capture_root": {"type": "string"},
    "sessions": {
      "type": "array",
      "items": {"$ref": "#/$defs/session"}
    },
    "coverage_totals": {"$ref": "#/$defs/coverageTotals"},
    "validation": {"$ref": "#/$defs/validation"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "coverage_contract_satisfied": {"type": "boolean"},
    "contract_satisfied": {"const": false},
    "event_ledger_feature_validation_allowed": {"const": false},
    "execution_latency_model_ready": {"const": false},
    "queue_model_ready": {"const": false},
    "true_scalping_allowed": {"const": false},
    "candidate_generation_allowed": {"const": false},
    "strategy_skeleton_generation_allowed": {"const": false},
    "promotion_allowed": {"const": false},
    "paper_review_pending_allowed": {"const": false},
    "paper_or_live_unlock_allowed": {"const": false},
    "guardrails": {"$ref": "#/$defs/guardrails"}
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "capture_report",
        "selected_bundle_dir",
        "status",
        "public_ws_only",
        "private_endpoint_used",
        "order_endpoint_used",
        "broker_calls_used",
        "capture_start",
        "capture_end",
        "capture_duration_seconds",
        "event_ledger_history_days",
        "message_count",
        "data_message_count",
        "trade_message_count",
        "book_message_count",
        "connection_count",
        "forced_reconnect_count",
        "replay_sequence_ready",
        "replay_report",
        "resync_policy_ready",
        "actual_reconnect_or_gap_exercised",
        "resync_report",
        "proxy_diagnostics_ready",
        "latency_queue_report"
      ],
      "properties": {
        "session_id": {"type": "string"},
        "capture_report": {"type": "string"},
        "selected_bundle_dir": {"type": "string"},
        "status": {"type": "string"},
        "public_ws_only": {"type": "boolean"},
        "private_endpoint_used": {"type": "boolean"},
        "order_endpoint_used": {"type": "boolean"},
        "broker_calls_used": {"type": "boolean"},
        "capture_start": {"type": "string"},
        "capture_end": {"type": "string"},
        "capture_duration_seconds": {"type": "number", "minimum": 0},
        "event_ledger_history_days": {"type": "number", "minimum": 0},
        "message_count": {"type": "integer", "minimum": 0},
        "data_message_count": {"type": "integer", "minimum": 0},
        "trade_message_count": {"type": "integer", "minimum": 0},
        "book_message_count": {"type": "integer", "minimum": 0},
        "connection_count": {"type": "integer", "minimum": 0},
        "forced_reconnect_count": {"type": "integer", "minimum": 0},
        "replay_sequence_ready": {"type": "boolean"},
        "replay_report": {"type": ["string", "null"]},
        "resync_policy_ready": {"type": "boolean"},
        "actual_reconnect_or_gap_exercised": {"type": "boolean"},
        "resync_report": {"type": ["string", "null"]},
        "proxy_diagnostics_ready": {"type": "boolean"},
        "latency_queue_report": {"type": ["string", "null"]}
      }
    },
    "coverageTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_count",
        "verified_public_session_count",
        "total_capture_duration_seconds",
        "total_event_ledger_history_days",
        "calendar_span_days",
        "remaining_research_capture_seconds",
        "remaining_event_ledger_history_days",
        "remaining_calendar_span_days",
        "total_message_count",
        "total_data_message_count",
        "total_trade_message_count",
        "total_book_message_count",
        "total_forced_reconnect_count",
        "replay_sequence_ready_session_count",
        "resync_policy_ready_session_count",
        "actual_reconnect_or_gap_exercised_session_count",
        "proxy_diagnostics_ready_session_count"
      ],
      "properties": {
        "session_count": {"type": "integer", "minimum": 0},
        "verified_public_session_count": {"type": "integer", "minimum": 0},
        "total_capture_duration_seconds": {"type": "number", "minimum": 0},
        "total_event_ledger_history_days": {"type": "number", "minimum": 0},
        "calendar_span_days": {"type": "number", "minimum": 0},
        "remaining_research_capture_seconds": {"type": "number", "minimum": 0},
        "remaining_event_ledger_history_days": {"type": "number", "minimum": 0},
        "remaining_calendar_span_days": {"type": "number", "minimum": 0},
        "total_message_count": {"type": "integer", "minimum": 0},
        "total_data_message_count": {"type": "integer", "minimum": 0},
        "total_trade_message_count": {"type": "integer", "minimum": 0},
        "total_book_message_count": {"type": "integer", "minimum": 0},
        "total_forced_reconnect_count": {"type": "integer", "minimum": 0},
        "replay_sequence_ready_session_count": {"type": "integer", "minimum": 0},
        "resync_policy_ready_session_count": {"type": "integer", "minimum": 0},
        "actual_reconnect_or_gap_exercised_session_count": {"type": "integer", "minimum": 0},
        "proxy_diagnostics_ready_session_count": {"type": "integer", "minimum": 0}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_reports_present",
        "verified_public_sessions_present",
        "public_source_boundary_satisfied",
        "required_channels_observed",
        "all_verified_sessions_have_replay_sequence_ready",
        "all_verified_sessions_have_proxy_diagnostics_ready",
        "resync_policy_exercised",
        "minimum_research_capture_seconds_satisfied",
        "minimum_event_ledger_history_days_satisfied",
        "minimum_calendar_span_days_satisfied",
        "execution_latency_model_ready",
        "queue_model_ready",
        "coverage_contract_satisfied"
      ],
      "properties": {
        "capture_reports_present": {"type": "boolean"},
        "verified_public_sessions_present": {"type": "boolean"},
        "public_source_boundary_satisfied": {"type": "boolean"},
        "required_channels_observed": {"type": "boolean"},
        "all_verified_sessions_have_replay_sequence_ready": {"type": "boolean"},
        "all_verified_sessions_have_proxy_diagnostics_ready": {"type": "boolean"},
        "resync_policy_exercised": {"type": "boolean"},
        "minimum_research_capture_seconds_satisfied": {"type": "boolean"},
        "minimum_event_ledger_history_days_satisfied": {"type": "boolean"},
        "minimum_calendar_span_days_satisfied": {"type": "boolean"},
        "execution_latency_model_ready": {"const": false},
        "queue_model_ready": {"const": false},
        "coverage_contract_satisfied": {"type": "boolean"}
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_only",
        "production_ready",
        "paper_or_live_usable",
        "private_endpoints_allowed",
        "order_endpoints_allowed",
        "broker_calls_allowed",
        "real_orders_created",
        "future_label_used_for_signal",
        "lookahead_used_for_signal",
        "paper_queue",
        "live"
      ],
      "properties": {
        "research_only": {"const": true},
        "production_ready": {"const": false},
        "paper_or_live_usable": {"const": false},
        "private_endpoints_allowed": {"const": false},
        "order_endpoints_allowed": {"const": false},
        "broker_calls_allowed": {"const": false},
        "real_orders_created": {"const": false},
        "future_label_used_for_signal": {"const": false},
        "lookahead_used_for_signal": {"const": false},
        "paper_queue": {"const": "LOCKED"},
        "live": {"const": "FROZEN"}
      }
    }
  }
}
