{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_corporate_action_status_report.schema.json",
  "title": "QuantStation VNEXT US Equity Corporate Action Status Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "selected_provider",
    "provider_verified_for_promotion",
    "promotion_clean",
    "price_source",
    "data_version",
    "symbol_count",
    "symbols_hash",
    "corporate_action_event_source_available",
    "split_events_available",
    "dividend_events_available",
    "merger_events_available",
    "delisting_events_available",
    "identifier_mapping_available",
    "adjustment_mode",
    "adjustment_reproducible",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_corporate_action_status_report_v1"},
    "generated_at": {"type": "string", "minLength": 1},
    "commit": {"type": ["string", "null"]},
    "branch": {"type": ["string", "null"]},
    "selected_provider": {"type": "string", "minLength": 1},
    "provider_verified_for_promotion": {"type": "boolean"},
    "provider_verification_report_path": {"type": "string"},
    "promotion_clean": {"type": "boolean"},
    "price_source": {"type": "string", "minLength": 1},
    "data_version": {"type": ["string", "null"]},
    "symbol_count": {"type": "integer", "minimum": 0},
    "symbols_hash": {"type": "string", "minLength": 1},
    "corporate_action_event_source_available": {"type": "boolean"},
    "split_events_available": {"type": "boolean"},
    "split_events_source": {"type": ["string", "null"]},
    "dividend_events_available": {"type": "boolean"},
    "dividend_events_source": {"type": ["string", "null"]},
    "merger_events_available": {"type": "boolean"},
    "merger_events_source": {"type": ["string", "null"]},
    "delisting_events_available": {"type": "boolean"},
    "delisting_events_source": {"type": ["string", "null"]},
    "identifier_mapping_available": {"type": "boolean"},
    "adjustment_mode": {"type": "string", "minLength": 1},
    "adjustment_reproducible": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
