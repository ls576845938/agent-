{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/btc_intraday_short_cycle_promotion_gate_report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "asset",
    "symbol",
    "strategy_id",
    "variant_id",
    "family_id",
    "status",
    "decision",
    "next_required_action",
    "source_reports",
    "checks",
    "blockers",
    "metrics",
    "gate",
    "manifest",
    "limitations",
    "manual_candidate_review_allowed",
    "candidate_generation_allowed",
    "strategy_skeleton_generation_allowed",
    "promotion_allowed",
    "paper_review_pending_allowed",
    "paper_or_live_unlock_allowed",
    "true_scalping_allowed",
    "guardrails"
  ],
  "properties": {
    "schema_version": {"const": "btc_intraday_short_cycle_promotion_gate_report_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "asset": {"const": "btc"},
    "symbol": {"const": "BTCUSDT"},
    "strategy_id": {"type": "string"},
    "variant_id": {"type": "string"},
    "family_id": {"const": "pullback_reclaim_intraday_v0"},
    "status": {"enum": ["ready_for_manual_candidate_review", "blocked_promotion_gate"]},
    "decision": {"enum": ["continue_research_manual_review_only", "back_to_event_definition_or_evidence_repair"]},
    "next_required_action": {"type": "string"},
    "source_reports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drift_guarded_event_ledger",
        "canonical_backtest_report",
        "event_objects",
        "trade_ledger",
        "cost_stress_report",
        "walk_forward_report",
        "regime_report",
        "tail_dependency_report",
        "run_manifest"
      ],
      "properties": {
        "drift_guarded_event_ledger": {"type": ["string", "null"]},
        "canonical_backtest_report": {"type": ["string", "null"]},
        "event_objects": {"type": ["string", "null"]},
        "trade_ledger": {"type": ["string", "null"]},
        "cost_stress_report": {"type": ["string", "null"]},
        "walk_forward_report": {"type": ["string", "null"]},
        "regime_report": {"type": ["string", "null"]},
        "tail_dependency_report": {"type": ["string", "null"]},
        "run_manifest": {"type": ["string", "null"]}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_ledger_report_present",
        "event_ledger_completed",
        "internal_gate_passed",
        "cost_stress_base_passed",
        "cost_stress_harsh_survives",
        "cost_stress_required_scenarios_present",
        "walk_forward_pass_rate_met",
        "regime_pass_rate_met",
        "tail_dependency_passed",
        "data_status_passed",
        "cost_model_passed",
        "manifest_file_present",
        "manifest_data_version_present",
        "manifest_strategy_version_present",
        "manifest_params_present",
        "manifest_cost_model_present",
        "manifest_slippage_model_present",
        "manifest_commit_hash_present",
        "pnl_from_fill_ledger_required",
        "strategy_signal_or_order_intent_only",
        "private_order_broker_paths_locked",
        "candidate_generation_still_locked",
        "paper_live_still_locked",
        "true_scalping_still_locked"
      ],
      "properties": {
        "event_ledger_report_present": {"type": "boolean"},
        "event_ledger_completed": {"type": "boolean"},
        "internal_gate_passed": {"type": "boolean"},
        "cost_stress_base_passed": {"type": "boolean"},
        "cost_stress_harsh_survives": {"type": "boolean"},
        "cost_stress_required_scenarios_present": {"type": "boolean"},
        "walk_forward_pass_rate_met": {"type": "boolean"},
        "regime_pass_rate_met": {"type": "boolean"},
        "tail_dependency_passed": {"type": "boolean"},
        "data_status_passed": {"type": "boolean"},
        "cost_model_passed": {"type": "boolean"},
        "manifest_file_present": {"type": "boolean"},
        "manifest_data_version_present": {"type": "boolean"},
        "manifest_strategy_version_present": {"type": "boolean"},
        "manifest_params_present": {"type": "boolean"},
        "manifest_cost_model_present": {"type": "boolean"},
        "manifest_slippage_model_present": {"type": "boolean"},
        "manifest_commit_hash_present": {"type": "boolean"},
        "pnl_from_fill_ledger_required": {"type": "boolean"},
        "strategy_signal_or_order_intent_only": {"type": "boolean"},
        "private_order_broker_paths_locked": {"type": "boolean"},
        "candidate_generation_still_locked": {"type": "boolean"},
        "paper_live_still_locked": {"type": "boolean"},
        "true_scalping_still_locked": {"type": "boolean"}
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_count",
        "fill_count",
        "profit_factor",
        "event_profit_factor",
        "walk_forward_pass_rate",
        "regime_pass_rate",
        "pbo",
        "dsr"
      ],
      "properties": {
        "trade_count": {"type": "integer", "minimum": 0},
        "fill_count": {"type": "integer", "minimum": 0},
        "profit_factor": {"type": ["number", "null"]},
        "event_profit_factor": {"type": ["number", "null"]},
        "walk_forward_pass_rate": {"type": ["number", "null"]},
        "regime_pass_rate": {"type": ["number", "null"]},
        "pbo": {"type": ["number", "null"]},
        "dsr": {"type": ["number", "null"]}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed", "fail_reasons", "thresholds"],
      "properties": {
        "status": {"type": "string"},
        "passed": {"type": "boolean"},
        "fail_reasons": {"type": "array", "items": {"type": "string"}},
        "thresholds": {"type": "object"}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_version",
        "strategy_version",
        "params_hash",
        "params",
        "cost_model",
        "slippage_model",
        "commit_hash"
      ],
      "properties": {
        "data_version": {"type": ["string", "null"]},
        "strategy_version": {"type": ["string", "null"]},
        "params_hash": {"type": ["string", "null"]},
        "params": {"type": "object"},
        "cost_model": {"type": ["string", "null"]},
        "slippage_model": {"type": ["string", "null"]},
        "commit_hash": {"type": ["string", "null"]}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "manual_candidate_review_allowed": {"type": "boolean"},
    "candidate_generation_allowed": {"const": false},
    "strategy_skeleton_generation_allowed": {"const": false},
    "promotion_allowed": {"const": false},
    "paper_review_pending_allowed": {"const": false},
    "paper_or_live_unlock_allowed": {"const": false},
    "true_scalping_allowed": {"const": false},
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_only",
        "manual_review_gate_only",
        "broker_calls_allowed",
        "private_endpoints_allowed",
        "order_endpoints_allowed",
        "real_orders_created",
        "paper_queue",
        "live",
        "pnl_from_fill_ledger_required"
      ],
      "properties": {
        "research_only": {"const": true},
        "manual_review_gate_only": {"const": true},
        "broker_calls_allowed": {"const": false},
        "private_endpoints_allowed": {"const": false},
        "order_endpoints_allowed": {"const": false},
        "real_orders_created": {"const": false},
        "paper_queue": {"const": "LOCKED"},
        "live": {"const": "FROZEN"},
        "pnl_from_fill_ledger_required": {"const": true}
      }
    }
  }
}
