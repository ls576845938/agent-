{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/btc_true_scalping_long_horizon_l2_tick_import_contract_report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "asset",
    "symbol",
    "venue_symbol",
    "scope",
    "status",
    "decision",
    "next_required_action",
    "import_manifest_root",
    "accepted_source_examples",
    "thresholds",
    "manifests",
    "coverage_totals",
    "validation",
    "blockers",
    "contract_satisfied",
    "long_horizon_l2_tick_history_ready",
    "candidate_generation_allowed",
    "strategy_skeleton_generation_allowed",
    "promotion_allowed",
    "paper_review_pending_allowed",
    "paper_or_live_unlock_allowed",
    "true_scalping_allowed",
    "guardrails"
  ],
  "properties": {
    "schema_version": {"const": "btc_true_scalping_long_horizon_l2_tick_import_contract_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "asset": {"const": "btc"},
    "symbol": {"const": "BTCUSDT"},
    "venue_symbol": {"const": "BTC-USDT-SWAP"},
    "scope": {"const": "research_only_long_horizon_l2_tick_import_contract_no_candidate_no_paper_no_live"},
    "status": {
      "enum": [
        "long_horizon_l2_tick_import_contract_missing_or_invalid_research_only",
        "long_horizon_l2_tick_import_contract_satisfied_research_only"
      ]
    },
    "decision": {"type": "string"},
    "next_required_action": {"type": "string"},
    "import_manifest_root": {"type": "string"},
    "accepted_source_examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_name", "url", "required_data"],
        "properties": {
          "source_name": {"type": "string"},
          "url": {"type": "string"},
          "required_data": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_tick_history_days",
        "minimum_l2_history_days",
        "minimum_common_calendar_span_days",
        "required_roles"
      ],
      "properties": {
        "minimum_tick_history_days": {"type": "number", "minimum": 30},
        "minimum_l2_history_days": {"type": "number", "minimum": 30},
        "minimum_common_calendar_span_days": {"type": "number", "minimum": 30},
        "required_roles": {"type": "array", "items": {"type": "string"}}
      }
    },
    "manifests": {"type": "array", "items": {"$ref": "#/$defs/importManifestSummary"}},
    "coverage_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_count",
        "valid_manifest_count",
        "valid_file_count",
        "tick_file_count",
        "l2_file_count",
        "tick_history_days",
        "l2_history_days",
        "common_calendar_span_days",
        "remaining_tick_history_days",
        "remaining_l2_history_days",
        "remaining_common_calendar_span_days",
        "total_record_count",
        "common_sample_start",
        "common_sample_end"
      ],
      "properties": {
        "manifest_count": {"type": "integer", "minimum": 0},
        "valid_manifest_count": {"type": "integer", "minimum": 0},
        "valid_file_count": {"type": "integer", "minimum": 0},
        "tick_file_count": {"type": "integer", "minimum": 0},
        "l2_file_count": {"type": "integer", "minimum": 0},
        "tick_history_days": {"type": "number", "minimum": 0},
        "l2_history_days": {"type": "number", "minimum": 0},
        "common_calendar_span_days": {"type": "number", "minimum": 0},
        "remaining_tick_history_days": {"type": "number", "minimum": 0},
        "remaining_l2_history_days": {"type": "number", "minimum": 0},
        "remaining_common_calendar_span_days": {"type": "number", "minimum": 0},
        "total_record_count": {"type": "integer", "minimum": 0},
        "common_sample_start": {"type": ["string", "null"]},
        "common_sample_end": {"type": ["string", "null"]}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "import_manifests_present",
        "public_or_licensed_archive_boundary_satisfied",
        "private_order_broker_boundary_satisfied",
        "file_integrity_satisfied",
        "tick_history_present",
        "l2_order_book_history_present",
        "minimum_tick_history_days_satisfied",
        "minimum_l2_history_days_satisfied",
        "minimum_common_calendar_span_days_satisfied",
        "contract_satisfied"
      ],
      "properties": {
        "import_manifests_present": {"type": "boolean"},
        "public_or_licensed_archive_boundary_satisfied": {"type": "boolean"},
        "private_order_broker_boundary_satisfied": {"type": "boolean"},
        "file_integrity_satisfied": {"type": "boolean"},
        "tick_history_present": {"type": "boolean"},
        "l2_order_book_history_present": {"type": "boolean"},
        "minimum_tick_history_days_satisfied": {"type": "boolean"},
        "minimum_l2_history_days_satisfied": {"type": "boolean"},
        "minimum_common_calendar_span_days_satisfied": {"type": "boolean"},
        "contract_satisfied": {"type": "boolean"}
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "contract_satisfied": {"type": "boolean"},
    "long_horizon_l2_tick_history_ready": {"type": "boolean"},
    "candidate_generation_allowed": {"const": false},
    "strategy_skeleton_generation_allowed": {"const": false},
    "promotion_allowed": {"const": false},
    "paper_review_pending_allowed": {"const": false},
    "paper_or_live_unlock_allowed": {"const": false},
    "true_scalping_allowed": {"const": false},
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_only",
        "status_report_only",
        "private_endpoints_allowed",
        "order_endpoints_allowed",
        "broker_calls_allowed",
        "real_orders_created",
        "paper_queue",
        "live",
        "true_scalping_claim_allowed"
      ],
      "properties": {
        "research_only": {"const": true},
        "status_report_only": {"const": true},
        "private_endpoints_allowed": {"const": false},
        "order_endpoints_allowed": {"const": false},
        "broker_calls_allowed": {"const": false},
        "real_orders_created": {"const": false},
        "paper_queue": {"const": "LOCKED"},
        "live": {"const": "FROZEN"},
        "true_scalping_claim_allowed": {"const": false}
      }
    }
  },
  "$defs": {
    "importManifestSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "manifest_id",
        "source_type",
        "venue",
        "venue_symbol",
        "symbol",
        "public_or_licensed_archive_only",
        "private_endpoint_used",
        "order_endpoint_used",
        "broker_calls_used",
        "files",
        "roles_present",
        "blockers",
        "valid_for_contract"
      ],
      "properties": {
        "manifest_path": {"type": "string"},
        "manifest_id": {"type": "string"},
        "source_type": {"type": "string"},
        "venue": {"type": "string"},
        "venue_symbol": {"type": "string"},
        "symbol": {"type": "string"},
        "public_or_licensed_archive_only": {"type": "boolean"},
        "private_endpoint_used": {"type": "boolean"},
        "order_endpoint_used": {"type": "boolean"},
        "broker_calls_used": {"type": "boolean"},
        "files": {"type": "array", "items": {"$ref": "#/$defs/importFileSummary"}},
        "roles_present": {"type": "array", "items": {"type": "string"}},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "valid_for_contract": {"type": "boolean"}
      }
    },
    "importFileSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "format",
        "source_endpoint_or_archive",
        "record_count",
        "sample_start",
        "sample_end",
        "sha256",
        "actual_sha256",
        "blockers",
        "valid"
      ],
      "properties": {
        "role": {"type": "string"},
        "path": {"type": "string"},
        "format": {"type": "string"},
        "source_endpoint_or_archive": {"type": "string"},
        "record_count": {"type": "integer", "minimum": 0},
        "sample_start": {"type": "string"},
        "sample_end": {"type": "string"},
        "sha256": {"type": "string"},
        "actual_sha256": {"type": "string"},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "valid": {"type": "boolean"}
      }
    }
  }
}
