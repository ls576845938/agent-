{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_development_plan_audit_report.schema.json",
  "title": "QuantStation VNEXT US Equity Development Plan Audit Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "asset",
    "status",
    "decision",
    "plan_path",
    "plan_exists",
    "phase_checks",
    "summary",
    "blockers",
    "unsafe_flags",
    "source_reports",
    "guardrails",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_development_plan_audit_v1"},
    "generated_at": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "minLength": 1},
    "branch": {"type": "string"},
    "asset": {"const": "us_equity"},
    "status": {
      "enum": [
        "development_plan_complete",
        "development_plan_in_progress",
        "development_plan_blocked_by_production_pit_data"
      ]
    },
    "decision": {"const": "continue_building_production_line_do_not_unlock_live"},
    "plan_path": {"type": "string", "minLength": 1},
    "plan_exists": {"type": "boolean"},
    "phase_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase_id", "title", "status", "evidence", "blockers", "metrics"],
        "properties": {
          "phase_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "status": {
            "enum": [
              "complete",
              "observing",
              "blocked_external_data",
              "blocked_data_quality",
              "blocked_manual_review",
              "action_required"
            ]
          },
          "evidence": {"type": "array", "items": {"type": "string"}},
          "blockers": {"type": "array", "items": {"type": "string"}},
          "metrics": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["phase_count", "complete_count", "observing_count", "blocked_count", "action_required_count"],
      "properties": {
        "phase_count": {"type": "integer", "minimum": 0},
        "complete_count": {"type": "integer", "minimum": 0},
        "observing_count": {"type": "integer", "minimum": 0},
        "blocked_count": {"type": "integer", "minimum": 0},
        "action_required_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "unsafe_flags": {"type": "array", "items": {"type": "string"}},
    "source_reports": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string"}
    },
    "guardrails": {
      "type": "object",
      "required": [
        "audit_only",
        "strategy_parameters_mutated",
        "paper_or_live_unlock_allowed",
        "paper_simulation_allowed",
        "live_order_allowed",
        "private_endpoint_allowed",
        "order_endpoint_allowed",
        "real_order_submitted"
      ],
      "properties": {
        "audit_only": {"const": true},
        "strategy_parameters_mutated": {"const": false},
        "paper_or_live_unlock_allowed": {"const": false},
        "paper_simulation_allowed": {"const": false},
        "live_order_allowed": {"const": false},
        "private_endpoint_allowed": {"const": false},
        "order_endpoint_allowed": {"const": false},
        "real_order_submitted": {"const": false}
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["json", "markdown"],
      "properties": {
        "json": {"type": "string", "minLength": 1},
        "markdown": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
