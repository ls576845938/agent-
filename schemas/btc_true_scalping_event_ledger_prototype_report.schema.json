{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/btc_true_scalping_event_ledger_prototype_report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "asset",
    "symbol",
    "strategy_id",
    "variant_id",
    "scope",
    "status",
    "decision",
    "next_required_action",
    "source_reports",
    "run_dir",
    "artifacts",
    "data_context",
    "event_definition",
    "metrics",
    "gate",
    "blockers",
    "manifest",
    "candidate_generation_allowed",
    "strategy_skeleton_generation_allowed",
    "promotion_allowed",
    "paper_review_pending_allowed",
    "paper_or_live_unlock_allowed",
    "true_scalping_allowed",
    "guardrails"
  ],
  "properties": {
    "schema_version": {"const": "btc_true_scalping_event_ledger_prototype_report_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "asset": {"const": "btc"},
    "symbol": {"const": "BTCUSDT"},
    "strategy_id": {"const": "btc_true_scalp_liquidity_reclaim_research_v0"},
    "variant_id": {"const": "pullback_reclaim_1m_public_microstructure_proxy_v0"},
    "scope": {"const": "research_only_1m_scalping_event_ledger_no_candidate_no_paper_no_live"},
    "status": {
      "enum": [
        "event_ledger_research_gate_passed_candidate_still_locked",
        "event_ledger_research_gate_failed",
        "event_ledger_research_gate_blocked"
      ]
    },
    "decision": {"type": "string"},
    "next_required_action": {"type": "string"},
    "source_reports": {"$ref": "#/$defs/stringMap"},
    "run_dir": {"type": ["string", "null"]},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_objects", "fill_ledger", "run_manifest"],
      "properties": {
        "event_objects": {"type": ["string", "null"]},
        "fill_ledger": {"type": ["string", "null"]},
        "run_manifest": {"type": ["string", "null"]}
      }
    },
    "data_context": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "exchange", "interval"],
      "properties": {
        "source": {"type": "string"},
        "exchange": {"type": "string"},
        "interval": {"const": "1m"},
        "data_version": {"type": "string"},
        "history_days": {"type": "integer", "minimum": 1},
        "row_count": {"type": "integer", "minimum": 0},
        "start": {"type": ["string", "null"]},
        "end": {"type": ["string", "null"]}
      }
    },
    "event_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_timestamp_field",
        "trigger_state_field",
        "context_state_field",
        "label_horizon_seconds",
        "event_count",
        "simulated_order_intent_only",
        "future_label_used_for_signal",
        "lookahead_used_for_signal"
      ],
      "properties": {
        "entry_timestamp_field": {"const": "entry_timestamp"},
        "trigger_state_field": {"const": "trigger_state"},
        "context_state_field": {"const": "context_state"},
        "label_horizon_seconds": {"type": "integer", "minimum": 0},
        "event_count": {"type": "integer", "minimum": 0},
        "simulated_order_intent_only": {"const": true},
        "future_label_used_for_signal": {"const": false},
        "lookahead_used_for_signal": {"const": false}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_count",
        "trade_count",
        "fill_count",
        "gross_profit",
        "gross_loss",
        "net_pnl",
        "profit_factor",
        "hit_rate",
        "mean_trade_return_bps",
        "median_trade_return_bps",
        "pnl_from_fill_ledger"
      ],
      "properties": {
        "event_count": {"type": "integer", "minimum": 0},
        "trade_count": {"type": "integer", "minimum": 0},
        "fill_count": {"type": "integer", "minimum": 0},
        "gross_profit": {"type": "number"},
        "gross_loss": {"type": "number"},
        "net_pnl": {"type": "number"},
        "profit_factor": {"type": ["number", "null"]},
        "hit_rate": {"type": "number", "minimum": 0},
        "mean_trade_return_bps": {"type": "number"},
        "median_trade_return_bps": {"type": "number"},
        "pnl_from_fill_ledger": {"const": true}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "status", "checks", "thresholds"],
      "properties": {
        "passed": {"type": "boolean"},
        "status": {"enum": ["candidate_gate_passed", "candidate_gate_failed"]},
        "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "thresholds": {"type": "object", "additionalProperties": {"type": "number"}}
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "manifest": {"type": "object"},
    "candidate_generation_allowed": {"const": false},
    "strategy_skeleton_generation_allowed": {"const": false},
    "promotion_allowed": {"const": false},
    "paper_review_pending_allowed": {"const": false},
    "paper_or_live_unlock_allowed": {"const": false},
    "true_scalping_allowed": {"const": false},
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_only",
        "broker_calls_allowed",
        "private_endpoints_allowed",
        "order_endpoints_allowed",
        "real_orders_created",
        "paper_queue",
        "live",
        "pnl_from_fill_ledger"
      ],
      "properties": {
        "research_only": {"const": true},
        "broker_calls_allowed": {"const": false},
        "private_endpoints_allowed": {"const": false},
        "order_endpoints_allowed": {"const": false},
        "real_orders_created": {"const": false},
        "paper_queue": {"const": "LOCKED"},
        "live": {"const": "FROZEN"},
        "pnl_from_fill_ledger": {"const": true}
      }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]}
    }
  }
}
