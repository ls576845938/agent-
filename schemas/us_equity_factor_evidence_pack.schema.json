{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_factor_evidence_pack.schema.json",
  "title": "QuantStation VNEXT US Equity Factor Evidence Pack",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "asset",
    "status",
    "data_version",
    "universe_version",
    "manifest_hash",
    "universe_name",
    "sample_start",
    "sample_end",
    "factor_name",
    "factor_version",
    "factor_family",
    "evidence_source",
    "is_placeholder",
    "is_data_dependent",
    "data_lineage",
    "inherited_data_blockers",
    "inherited_provider_blockers",
    "factor_metric_blockers",
    "metrics",
    "gates",
    "blocker_reasons",
    "allowed_next_action",
    "data_status_report",
    "data_versions",
    "symbols",
    "latest_factor_mining_report",
    "factor_mining_run_count",
    "generated_factors_path",
    "generated_factor_count",
    "generated_strategy_count",
    "candidate_count",
    "selected_factor_count",
    "selected_factor_ids",
    "compiled_strategy_count",
    "latest_correlation_report",
    "evidence_coverage",
    "quality_filter",
    "factor_rows",
    "factor_evidence_rows",
    "factor_count",
    "factor_pass_count",
    "factor_fail_count",
    "current_factor_candidates",
    "required_evidence",
    "blockers",
    "promotion_ready",
    "paper_queue_status",
    "live_status"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_factor_evidence_pack_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "asset": {"const": "us_equity"},
    "status": {"enum": ["missing", "partial", "complete"]},
    "data_version": {"type": "string"},
    "universe_version": {"type": "string"},
    "manifest_hash": {"type": "string"},
    "universe_name": {"type": "string"},
    "sample_start": {"type": "string"},
    "sample_end": {"type": "string"},
    "factor_name": {"type": "string"},
    "factor_version": {"type": "string"},
    "factor_family": {"type": "string"},
    "evidence_source": {"type": "string"},
    "is_placeholder": {"type": "boolean"},
    "is_data_dependent": {"type": "boolean"},
    "data_lineage": {
      "type": "object",
      "required": [
        "data_version",
        "universe_version",
        "manifest_hash",
        "universe_snapshot_manifest_path",
        "corporate_action_status_report_path",
        "survivorship_audit_report_path",
        "provider_verification_report_path",
        "data_lineage_grade",
        "promotion_clean",
        "selected_provider",
        "source_type",
        "bundle_id",
        "provider_verified_for_promotion",
        "inherited_data_blockers",
        "inherited_provider_blockers",
        "factor_metric_blockers"
      ],
      "properties": {
        "data_version": {"type": "string"},
        "universe_version": {"type": "string"},
        "manifest_hash": {"type": "string"},
        "universe_snapshot_manifest_path": {"type": ["string", "null"]},
        "corporate_action_status_report_path": {"type": ["string", "null"]},
        "survivorship_audit_report_path": {"type": ["string", "null"]},
        "provider_verification_report_path": {"type": ["string", "null"]},
        "data_lineage_grade": {"$ref": "#/$defs/dataLineageGrade"},
        "promotion_clean": {"type": "boolean"},
        "selected_provider": {"enum": ["yfinance", "local_csv", "crsp", "sharadar", "polygon", "norgate", "none"]},
        "source_type": {"enum": ["fixture", "sample", "production", "research_price_bars", "none"]},
        "bundle_id": {"type": ["string", "null"]},
        "provider_verified_for_promotion": {"type": "boolean"},
        "inherited_data_blockers": {"type": "array", "items": {"type": "string"}},
        "inherited_provider_blockers": {"type": "array", "items": {"type": "string"}},
        "factor_metric_blockers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "inherited_data_blockers": {"type": "array", "items": {"type": "string"}},
    "inherited_provider_blockers": {"type": "array", "items": {"type": "string"}},
    "factor_metric_blockers": {"type": "array", "items": {"type": "string"}},
    "metrics": {
      "type": "object",
      "required": ["factor_count", "factor_pass_count", "factor_fail_count"],
      "properties": {
        "factor_count": {"type": "integer", "minimum": 0},
        "factor_pass_count": {"type": "integer", "minimum": 0},
        "factor_fail_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "gates": {
      "type": "object",
      "required": ["data_lineage_pass", "required_evidence_present", "overall_status"],
      "properties": {
        "data_lineage_pass": {"type": "boolean"},
        "required_evidence_present": {"type": "boolean"},
        "overall_status": {"enum": ["pass", "fail"]}
      },
      "additionalProperties": true
    },
    "blocker_reasons": {"type": "array", "items": {"type": "string"}},
    "allowed_next_action": {
      "enum": ["research_only", "rerun_required", "portfolio_candidate_review"]
    },
    "data_status_report": {"type": ["string", "null"]},
    "data_versions": {"type": "array", "items": {"type": "string"}},
    "symbols": {"type": "array", "items": {"type": "string"}},
    "latest_factor_mining_report": {"type": ["string", "null"]},
    "factor_mining_run_count": {"type": "integer", "minimum": 0},
    "generated_factors_path": {"type": ["string", "null"]},
    "generated_factor_count": {"type": "integer", "minimum": 0},
    "generated_strategy_count": {"type": "integer", "minimum": 0},
    "candidate_count": {"type": "integer", "minimum": 0},
    "selected_factor_count": {"type": "integer", "minimum": 0},
    "selected_factor_ids": {"type": "array", "items": {"type": "string"}},
    "compiled_strategy_count": {"type": "integer", "minimum": 0},
    "latest_correlation_report": {"type": ["string", "null"]},
    "evidence_coverage": {
      "type": "object",
      "required": [
        "style_exposure",
        "capacity",
        "turnover",
        "bar_samples_available",
        "lookahead_guard"
      ],
      "properties": {
        "style_exposure": {"type": "object"},
        "capacity": {"type": "object"},
        "turnover": {"type": "object"},
        "bar_samples_available": {"type": "object"},
        "lookahead_guard": {"type": "string"}
      },
      "additionalProperties": false
    },
    "quality_filter": {"type": "object"},
    "factor_rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/factorEvidenceRow"}
    },
    "factor_evidence_rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/factorEvidenceRow"}
    },
    "factor_count": {"type": "integer", "minimum": 0},
    "factor_pass_count": {"type": "integer", "minimum": 0},
    "factor_fail_count": {"type": "integer", "minimum": 0},
    "current_factor_candidates": {"type": "array", "items": {"type": "string"}},
    "required_evidence": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "promotion_ready": {"const": false},
    "paper_queue_status": {"const": "locked"},
    "live_status": {"const": "frozen"}
  },
  "$defs": {
    "dataLineageGrade": {
      "type": "object",
      "required": ["value", "reason"],
      "properties": {
        "value": {
          "enum": [
            "L0_fixture",
            "L1_sample_non_pit",
            "L2_static_snapshot",
            "L3_point_in_time_universe",
            "L4_promotion_clean"
          ]
        },
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "factorEvidenceRow": {
      "type": "object",
      "required": [
        "factor_id",
        "bar_size",
        "candidate_rank",
        "selected",
        "rank_ic_mean",
        "ic_mean",
        "hit_rate",
        "turnover",
        "quality_score",
        "stability_score",
        "reject_reason",
        "factor_name",
        "factor_version",
        "factor_family",
        "evidence_source",
        "is_placeholder",
        "is_data_dependent",
        "data_version",
        "universe_version",
        "manifest_hash",
        "universe_name",
        "sample_start",
        "sample_end",
        "factor_identity",
        "data_lineage",
        "metrics",
        "stability",
        "gates",
        "blocker_reasons",
        "allowed_next_action",
        "overall_status"
      ],
      "properties": {
        "factor_id": {"type": "string"},
        "bar_size": {"type": "string"},
        "candidate_rank": {"type": "integer", "minimum": 0},
        "selected": {"type": "boolean"},
        "rank_ic_mean": {"type": "number"},
        "ic_mean": {"type": "number"},
        "hit_rate": {"type": "number"},
        "turnover": {"type": "number"},
        "quality_score": {"type": "number"},
        "stability_score": {"type": "number"},
        "reject_reason": {"type": "string"},
        "factor_name": {"type": "string"},
        "factor_version": {"type": "string"},
        "factor_family": {"type": "string"},
        "evidence_source": {"type": "string"},
        "is_placeholder": {"type": "boolean"},
        "is_data_dependent": {"type": "boolean"},
        "data_version": {"type": "string"},
        "universe_version": {"type": "string"},
        "manifest_hash": {"type": "string"},
        "universe_name": {"type": "string"},
        "sample_start": {"type": "string"},
        "sample_end": {"type": "string"},
        "factor_identity": {
          "type": "object",
          "required": [
            "factor_name",
            "factor_family",
            "factor_version",
            "input_columns",
            "calculation_window",
            "rebalance_frequency"
          ],
          "properties": {
            "factor_name": {"type": "string"},
            "factor_family": {"type": "string"},
            "factor_version": {"type": "string"},
            "input_columns": {"type": "array", "items": {"type": "string"}},
            "calculation_window": {"type": "string"},
            "rebalance_frequency": {"type": "string"}
          },
          "additionalProperties": false
        },
        "data_lineage": {
          "type": "object",
          "required": [
            "data_version",
            "universe_version",
            "manifest_hash",
            "sample_start",
            "sample_end",
            "symbol_count",
            "calendar",
            "adjustment_mode",
            "survivorship_status",
            "universe_snapshot_manifest_path",
            "corporate_action_status_report_path",
            "survivorship_audit_report_path",
            "provider_verification_report_path",
            "data_lineage_grade",
            "promotion_clean",
            "selected_provider",
            "source_type",
            "bundle_id",
            "provider_verified_for_promotion",
            "inherited_provider_blockers",
            "inherited_data_blockers"
          ],
          "properties": {
            "data_version": {"type": "string"},
            "data_versions": {"type": "array", "items": {"type": "string"}},
            "universe_version": {"type": "string"},
            "manifest_hash": {"type": "string"},
            "universe_name": {"type": "string"},
            "sample_start": {"type": "string"},
            "sample_end": {"type": "string"},
            "symbol_count": {"type": "integer", "minimum": 0},
            "calendar": {"type": "string"},
            "adjustment_mode": {"type": "string"},
            "survivorship_status": {"type": "string"},
            "universe_snapshot_manifest_path": {"type": ["string", "null"]},
            "corporate_action_status_report_path": {"type": ["string", "null"]},
            "survivorship_audit_report_path": {"type": ["string", "null"]},
            "provider_verification_report_path": {"type": ["string", "null"]},
            "data_lineage_grade": {"$ref": "#/$defs/dataLineageGrade"},
            "promotion_clean": {"type": "boolean"},
            "selected_provider": {"enum": ["yfinance", "local_csv", "crsp", "sharadar", "polygon", "norgate", "none"]},
            "source_type": {"enum": ["fixture", "sample", "production", "research_price_bars", "none"]},
            "bundle_id": {"type": ["string", "null"]},
            "provider_verified_for_promotion": {"type": "boolean"},
            "inherited_provider_blockers": {"type": "array", "items": {"type": "string"}},
            "inherited_data_blockers": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "required": [
            "IC_mean",
            "IC_std",
            "Rank_IC_mean",
            "Rank_IC_std",
            "IC_hit_rate",
            "IC_decay",
            "long_short_spread",
            "cost_adjusted_spread",
            "turnover",
            "coverage",
            "missing_rate"
          ],
          "properties": {
            "IC_mean": {"type": "number"},
            "IC_std": {"type": "number"},
            "Rank_IC_mean": {"type": "number"},
            "Rank_IC_std": {"type": "number"},
            "IC_hit_rate": {"type": "number"},
            "IC_decay": {"type": ["object", "number", "null"]},
            "long_short_spread": {"type": "number"},
            "cost_adjusted_spread": {"type": ["number", "null"]},
            "turnover": {"type": "number"},
            "coverage": {"type": ["number", "null"]},
            "missing_rate": {"type": ["number", "null"]},
            "n_observations": {"type": "integer", "minimum": 0},
            "n_dates": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        },
        "stability": {
          "type": "object",
          "required": [
            "walk_forward_fold_count",
            "walk_forward_pass_count",
            "walk_forward_pass_rate",
            "worst_fold_metric",
            "regime_breakdown"
          ],
          "properties": {
            "walk_forward_fold_count": {"type": "integer", "minimum": 0},
            "walk_forward_pass_count": {"type": "integer", "minimum": 0},
            "walk_forward_pass_rate": {"type": ["number", "null"]},
            "worst_fold_metric": {"type": ["number", "null"]},
            "regime_breakdown": {"type": "string"}
          },
          "additionalProperties": false
        },
        "gates": {
          "type": "object",
          "required": [
            "data_lineage_pass",
            "IC_pass",
            "rank_IC_pass",
            "turnover_pass",
            "cost_adjusted_pass",
            "walk_forward_pass",
            "overall_status"
          ],
          "properties": {
            "data_lineage_pass": {"type": "boolean"},
            "IC_pass": {"type": "boolean"},
            "rank_IC_pass": {"type": "boolean"},
            "turnover_pass": {"type": "boolean"},
            "cost_adjusted_pass": {"type": "boolean"},
            "walk_forward_pass": {"type": "boolean"},
            "overall_status": {"enum": ["pass", "fail"]}
          },
          "additionalProperties": false
        },
        "blocker_reasons": {"type": "array", "items": {"type": "string"}},
        "allowed_next_action": {
          "enum": ["research_only", "rerun_required", "portfolio_candidate_review"]
        },
        "overall_status": {"enum": ["pass", "fail"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
