{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "us_etf_26_canonical_backtest_report.schema.json",
  "title": "US ETF26 Canonical Event-Driven Backtest Report",
  "type": "object",
  "required": [
    "schema_version", "status", "decision", "generated_at", "code_commit",
    "code_tree_hash", "run_id", "candidate", "data", "event_chain",
    "execution", "cost_model", "performance", "ledger_reconciliation",
    "no_lookahead", "walk_forward", "cost_stress", "independent_confirmation",
    "corporate_actions", "dependencies", "hashes", "blockers", "guardrails", "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "us_etf_26_canonical_backtest_report_v1"},
    "status": {"const": "complete_research_only_blocked"},
    "decision": {"const": "canonical_research_evidence_complete_promotion_credit_disallowed_confirmation_incomplete"},
    "generated_at": {"type": "string", "minLength": 1},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "code_tree_hash": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "string", "pattern": "^us-etf26-canonical-[0-9a-f]{16}$"},
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "strategy_version", "params", "params_hash", "symbol", "timeframe", "parameter_tuning_performed", "symbol_or_timeframe_reselection_performed"],
      "properties": {
        "candidate_id": {"const": "us-etf26-complete-return-qqq-1d-v1"},
        "strategy_version": {"const": "us_etf_complete_return_fixed_signal_v1"},
        "params": {"type": "object"},
        "params_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "symbol": {"const": "QQQ"},
        "timeframe": {"const": "1D"},
        "parameter_tuning_performed": {"const": false},
        "symbol_or_timeframe_reselection_performed": {"const": false}
      },
      "additionalProperties": true
    },
    "data": {
      "type": "object",
      "required": ["data_version", "readiness_class", "manifest_git_spec", "manifest_sha256", "aggregate_sha256", "qqq_sha256", "consumer_read_only", "quality"],
      "properties": {
        "data_version": {"const": "hf-data-library-etf26-clean-1min-6d6b07e77962"},
        "readiness_class": {"const": "research_ready"},
        "consumer_read_only": {"const": true}
      },
      "additionalProperties": true
    },
    "event_chain": {
      "type": "object",
      "required": ["sequence", "strategy_has_io_dependency", "strategy_has_broker_dependency", "strategy_has_database_dependency", "audit_required_fields_present", "deterministic_replay_hash_match"],
      "properties": {
        "sequence": {"const": ["MarketData", "Signal", "Forecast", "TargetPosition", "RiskDecision", "OrderIntent", "SimulatedFill", "PositionCashLedger", "Report"]},
        "strategy_has_io_dependency": {"const": false},
        "strategy_has_broker_dependency": {"const": false},
        "strategy_has_database_dependency": {"const": false},
        "audit_required_fields_present": {"const": true},
        "deterministic_replay_hash_match": {"const": true}
      },
      "additionalProperties": true
    },
    "ledger_reconciliation": {
      "type": "object",
      "required": ["status", "passed", "cash_delta", "quantity_delta", "equity_delta", "orphan_fill_count", "price_series_nav_substitution_used"],
      "properties": {
        "status": {"const": "pass"},
        "passed": {"const": true},
        "cash_delta": {"type": "number", "minimum": -0.000001, "maximum": 0.000001},
        "quantity_delta": {"type": "number", "minimum": -0.00000001, "maximum": 0.00000001},
        "equity_delta": {"type": "number", "minimum": -0.000001, "maximum": 0.000001},
        "orphan_fill_count": {"const": 0},
        "price_series_nav_substitution_used": {"const": false}
      },
      "additionalProperties": true
    },
    "independent_confirmation": {
      "type": "object",
      "required": ["status", "evaluation_performed", "evaluation_allowed", "parameters_changed", "selection_or_ranking_performed"],
      "properties": {
        "status": {"const": "incomplete"},
        "evaluation_performed": {"const": false},
        "evaluation_allowed": {"const": false},
        "parameters_changed": {"const": false},
        "selection_or_ranking_performed": {"const": false}
      },
      "additionalProperties": true
    },
    "corporate_actions": {
      "type": "object",
      "required": ["status", "adjustment_available_time_replay", "pnl_adjustment_total"],
      "properties": {
        "status": {"const": "blocked_external_data"},
        "adjustment_available_time_replay": {"const": false},
        "pnl_adjustment_total": {"const": 0.0}
      },
      "additionalProperties": true
    },
    "dependencies": {
      "type": "object",
      "required": ["goal2_status", "goal2_blockers"],
      "properties": {"goal2_status": {"const": "blocked_external_data"}},
      "additionalProperties": true
    },
    "hashes": {
      "type": "object",
      "required": ["data_aggregate_sha256", "data_manifest_sha256", "qqq_file_sha256", "strategy_config_sha256", "strategy_source_sha256", "params_hash", "cost_model_hash", "slippage_model_hash", "run_inputs_hash", "code_tree_hash"],
      "additionalProperties": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "contains": {"const": "production_pit_intake_blocked_external_data"}
    },
    "guardrails": {
      "type": "object",
      "required": ["research_only", "promotion_credit_allowed", "promotion_unlock_allowed", "paper_or_live_unlock_allowed", "paper_order_allowed", "live_order_allowed", "paper_queue_write_allowed", "private_endpoint_used", "order_endpoint_used", "broker_endpoint_used", "network_used", "secret_read", "real_order_submitted", "source_data_modified"],
      "properties": {
        "research_only": {"const": true},
        "promotion_credit_allowed": {"const": false},
        "promotion_unlock_allowed": {"const": false},
        "paper_or_live_unlock_allowed": {"const": false},
        "paper_order_allowed": {"const": false},
        "live_order_allowed": {"const": false},
        "paper_queue_write_allowed": {"const": false},
        "private_endpoint_used": {"const": false},
        "order_endpoint_used": {"const": false},
        "broker_endpoint_used": {"const": false},
        "network_used": {"const": false},
        "secret_read": {"const": false},
        "real_order_submitted": {"const": false},
        "source_data_modified": {"const": false}
      },
      "additionalProperties": false
    },
    "artifacts": {"type": "object"}
  },
  "additionalProperties": true
}
