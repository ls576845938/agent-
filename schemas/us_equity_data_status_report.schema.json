{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_data_status_report.schema.json",
  "title": "QuantStation VNEXT US Equity Data Status Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "asset",
    "status",
    "manifest_count",
    "latest_data_manifest",
    "data_versions",
    "symbols",
    "sources",
    "intervals",
    "calendar_id",
    "timezone",
    "timezone_status",
    "adjustment_policies",
    "adjustment_mode",
    "survivorship_status",
    "data_lineage_grade",
    "data_lineage_maturity",
    "promotion_clean",
    "quality_summary",
    "universe_manifest_path",
    "corporate_action_report_path",
    "universe_snapshot_manifest_path",
    "corporate_action_status_report_path",
    "survivorship_audit_report_path",
    "provider_capability_matrix_path",
    "production_bundle_preflight_report_path",
    "provider_verification_report_path",
    "selected_provider",
    "source_type",
    "bundle_id",
    "production_bundle_preflight_pass",
    "explicit_bundle_selection_confirmed",
    "provider_verified_for_promotion",
    "blockers",
    "promotion_ready",
    "paper_queue_status",
    "live_status"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_data_status_report_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "asset": {"const": "us_equity"},
    "status": {"enum": ["missing", "partial", "complete"]},
    "manifest_count": {"type": "integer", "minimum": 0},
    "latest_data_manifest": {"type": ["string", "null"]},
    "data_versions": {"type": "array", "items": {"type": "string"}},
    "symbols": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"enum": ["yfinance", "alpaca"]}},
    "intervals": {"type": "array", "items": {"type": "string"}},
    "calendar_id": {"const": "XNYS"},
    "timezone": {"const": "UTC"},
    "timezone_status": {"enum": ["missing", "utc", "mixed_or_non_utc"]},
    "adjustment_policies": {"type": "array", "items": {"type": "string"}},
    "adjustment_mode": {"enum": ["raw", "adj_close", "auto_adjust", "back_adjust", "unknown"]},
    "survivorship_status": {"type": "string"},
    "data_lineage_grade": {
      "type": "object",
      "required": ["value", "reason"],
      "properties": {
        "value": {
          "enum": [
            "L0_fixture",
            "L1_sample_non_pit",
            "L2_static_snapshot",
            "L3_point_in_time_universe",
            "L4_promotion_clean"
          ]
        },
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "data_lineage_maturity": {
      "type": "object",
      "required": [
        "price_data_available",
        "universe_snapshot_available",
        "point_in_time_universe_confirmed",
        "corporate_action_event_source_available",
        "split_adjustment_confirmed",
        "dividend_adjustment_confirmed",
        "delisting_coverage_confirmed",
        "identifier_mapping_available",
        "adjustment_reproducibility_confirmed",
        "survivorship_clean",
        "promotion_clean"
      ],
      "properties": {
        "price_data_available": {"type": "boolean"},
        "universe_snapshot_available": {"type": "boolean"},
        "point_in_time_universe_confirmed": {"type": "boolean"},
        "corporate_action_event_source_available": {"type": "boolean"},
        "split_adjustment_confirmed": {"type": "boolean"},
        "dividend_adjustment_confirmed": {"type": "boolean"},
        "delisting_coverage_confirmed": {"type": "boolean"},
        "identifier_mapping_available": {"type": "boolean"},
        "adjustment_reproducibility_confirmed": {"type": "boolean"},
        "survivorship_clean": {"type": "boolean"},
        "promotion_clean": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "promotion_clean": {"type": "boolean"},
    "quality_summary": {
      "type": "object",
      "required": [
        "min_coverage_pct",
        "avg_coverage_pct",
        "min_quality_score",
        "avg_quality_score",
        "missing_bars",
        "duplicate_bars",
        "invalid_ohlc_rows",
        "non_positive_price_rows",
        "zero_volume_bars",
        "total_issue_count"
      ],
      "properties": {
        "min_coverage_pct": {"type": "number"},
        "avg_coverage_pct": {"type": "number"},
        "min_quality_score": {"type": "number"},
        "avg_quality_score": {"type": "number"},
        "missing_bars": {"type": "integer", "minimum": 0},
        "duplicate_bars": {"type": "integer", "minimum": 0},
        "invalid_ohlc_rows": {"type": "integer", "minimum": 0},
        "non_positive_price_rows": {"type": "integer", "minimum": 0},
        "zero_volume_bars": {"type": "integer", "minimum": 0},
        "total_issue_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "universe_manifest_path": {"type": "string"},
    "corporate_action_report_path": {"type": "string"},
    "universe_snapshot_manifest_path": {"type": "string"},
    "corporate_action_status_report_path": {"type": "string"},
    "survivorship_audit_report_path": {"type": "string"},
    "provider_capability_matrix_path": {"type": "string"},
    "production_bundle_preflight_report_path": {"type": "string"},
    "provider_verification_report_path": {"type": "string"},
    "selected_provider": {"enum": ["yfinance", "local_csv", "crsp", "sharadar", "polygon", "norgate", "none"]},
    "source_type": {"enum": ["fixture", "sample", "production", "research_price_bars", "none"]},
    "bundle_id": {"type": ["string", "null"]},
    "production_bundle_preflight_pass": {"type": "boolean"},
    "explicit_bundle_selection_confirmed": {"type": "boolean"},
    "provider_verified_for_promotion": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "promotion_ready": {"const": false},
    "paper_queue_status": {"const": "locked"},
    "live_status": {"const": "frozen"}
  },
  "additionalProperties": false
}
