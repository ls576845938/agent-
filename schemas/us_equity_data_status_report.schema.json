{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_data_status_report.schema.json",
  "title": "QuantStation VNEXT US Equity Data Status Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "asset",
    "status",
    "manifest_count",
    "latest_data_manifest",
    "data_versions",
    "symbols",
    "sources",
    "intervals",
    "calendar_id",
    "timezone",
    "timezone_status",
    "adjustment_policies",
    "survivorship_status",
    "quality_summary",
    "universe_manifest_path",
    "corporate_action_report_path",
    "blockers",
    "promotion_ready",
    "paper_queue_status",
    "live_status"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_data_status_report_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "asset": {"const": "us_equity"},
    "status": {"enum": ["missing", "partial", "complete"]},
    "manifest_count": {"type": "integer", "minimum": 0},
    "latest_data_manifest": {"type": ["string", "null"]},
    "data_versions": {"type": "array", "items": {"type": "string"}},
    "symbols": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"enum": ["yfinance", "alpaca"]}},
    "intervals": {"type": "array", "items": {"type": "string"}},
    "calendar_id": {"const": "XNYS"},
    "timezone": {"const": "UTC"},
    "timezone_status": {"enum": ["missing", "utc", "mixed_or_non_utc"]},
    "adjustment_policies": {"type": "array", "items": {"type": "string"}},
    "survivorship_status": {"type": "string"},
    "quality_summary": {
      "type": "object",
      "required": [
        "min_coverage_pct",
        "avg_coverage_pct",
        "min_quality_score",
        "avg_quality_score",
        "missing_bars",
        "duplicate_bars",
        "invalid_ohlc_rows",
        "non_positive_price_rows",
        "zero_volume_bars",
        "total_issue_count"
      ],
      "properties": {
        "min_coverage_pct": {"type": "number"},
        "avg_coverage_pct": {"type": "number"},
        "min_quality_score": {"type": "number"},
        "avg_quality_score": {"type": "number"},
        "missing_bars": {"type": "integer", "minimum": 0},
        "duplicate_bars": {"type": "integer", "minimum": 0},
        "invalid_ohlc_rows": {"type": "integer", "minimum": 0},
        "non_positive_price_rows": {"type": "integer", "minimum": 0},
        "zero_volume_bars": {"type": "integer", "minimum": 0},
        "total_issue_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "universe_manifest_path": {"type": "string"},
    "corporate_action_report_path": {"type": "string"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "promotion_ready": {"const": false},
    "paper_queue_status": {"const": "locked"},
    "live_status": {"const": "frozen"}
  },
  "additionalProperties": false
}
