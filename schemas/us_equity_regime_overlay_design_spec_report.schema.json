{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_regime_overlay_design_spec_report.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "asset",
    "status",
    "decision",
    "strategy_id",
    "registry_strategy_id",
    "family",
    "hypothesis",
    "signal_design",
    "portfolio_design",
    "data_contract",
    "parameter_space_before_backtest",
    "validation_plan",
    "failure_conditions",
    "required_design_outputs",
    "guardrails",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_regime_overlay_design_spec_report_v1"},
    "generated_at": {"type": "string", "minLength": 1},
    "asset": {"const": "us_equity"},
    "status": {"const": "design_spec_ready"},
    "decision": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "registry_strategy_id": {"const": "us_equity_regime_overlay_research_placeholder"},
    "family": {"const": "regime_overlay"},
    "immutable_strategy_id_required_before_backtest": {"const": true},
    "hypothesis": {"type": "object"},
    "signal_design": {"type": "object"},
    "portfolio_design": {"type": "object"},
    "data_contract": {"type": "object"},
    "parameter_space_before_backtest": {"type": "object"},
    "validation_plan": {"type": "object"},
    "failure_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "required_design_outputs": {
      "type": "array",
      "minItems": 6,
      "items": {"type": "string"}
    },
    "guardrails": {
      "type": "object",
      "required": [
        "design_spec_only",
        "standardized_backtest_allowed_by_this_report",
        "paper_or_live_unlock_allowed",
        "paper_simulation_allowed",
        "live_order_allowed",
        "private_endpoint_allowed",
        "order_endpoint_allowed",
        "real_order_submitted",
        "broker_calls_used"
      ],
      "properties": {
        "design_spec_only": {"const": true},
        "standardized_backtest_allowed_by_this_report": {"const": false},
        "strategy_parameters_mutated": {"const": false},
        "paper_or_live_unlock_allowed": {"const": false},
        "paper_simulation_allowed": {"const": false},
        "live_order_allowed": {"const": false},
        "private_endpoint_allowed": {"const": false},
        "order_endpoint_allowed": {"const": false},
        "real_order_submitted": {"const": false},
        "broker_calls_used": {"const": false}
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": ["json", "markdown"],
      "properties": {
        "json": {"type": "string", "minLength": 1},
        "markdown": {"type": "string", "minLength": 1}
      }
    }
  },
  "additionalProperties": true
}
