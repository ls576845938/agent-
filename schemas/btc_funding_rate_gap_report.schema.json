{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/btc_funding_rate_gap_report.schema.json",
  "title": "QuantStation VNEXT BTC Funding Rate Gap Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "bundle_id",
    "symbol",
    "sample_start",
    "sample_end",
    "funding_rate_path",
    "record_count",
    "first_funding_time",
    "last_funding_time",
    "duplicate_funding_time_count",
    "monotonic_time_pass",
    "observed_interval_hours_distribution",
    "dominant_interval_hours",
    "interval_inference_confidence",
    "expected_missing_funding_times",
    "expected_missing_funding_time_ms",
    "missing_range_start",
    "missing_range_end",
    "coverage_complete",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "btc_funding_rate_gap_report_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "bundle_id": {"type": "string"},
    "symbol": {"const": "BTCUSDT"},
    "sample_start": {"type": "string"},
    "sample_end": {"type": "string"},
    "funding_rate_path": {"type": "string"},
    "record_count": {"type": "integer", "minimum": 0},
    "first_funding_time": {"type": ["string", "null"]},
    "last_funding_time": {"type": ["string", "null"]},
    "duplicate_funding_time_count": {"type": "integer", "minimum": 0},
    "monotonic_time_pass": {"type": "boolean"},
    "observed_interval_hours_distribution": {"type": "object"},
    "dominant_interval_hours": {"type": ["number", "null"]},
    "interval_inference_confidence": {"enum": ["high", "medium", "low", "none"]},
    "irregular_interval_count": {"type": "integer", "minimum": 0},
    "expected_missing_funding_times": {"type": "array", "items": {"type": "string"}},
    "expected_missing_funding_time_ms": {"type": "array", "items": {"type": "integer"}},
    "missing_range_start": {"type": ["string", "null"]},
    "missing_range_end": {"type": ["string", "null"]},
    "coverage_complete": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
