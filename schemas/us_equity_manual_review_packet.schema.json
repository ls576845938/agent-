{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_manual_review_packet.schema.json",
  "title": "QuantStation VNEXT US Equity Manual Review Packet",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "asset",
    "strategy_id",
    "decision",
    "review_items",
    "remediation_tickets",
    "forward_review_progress",
    "review_milestones",
    "evidence_checklist",
    "signoff_requirements",
    "paper_or_live_unlock_decision",
    "blockers",
    "unsafe_flags",
    "guardrails",
    "source_reports",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_manual_review_packet_v1"},
    "generated_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["manual_review_pending", "manual_review_ready"]},
    "asset": {"const": "us_equity"},
    "strategy_id": {"type": "string", "minLength": 1},
    "decision": {"const": "human_review_required"},
    "review_items": {
      "type": "object",
      "required": ["strategy_evidence", "forward_observation", "data_freshness", "account_constraints", "production_pit_data", "remediation_tickets", "live_readiness", "manual_decision_record"],
      "additionalProperties": {"type": "object"}
    },
    "remediation_tickets": {
      "type": "object",
      "required": [
        "source_status",
        "ticket_count",
        "external_or_time_dependency_count",
        "engineering_dependency_count",
        "manual_dependency_count",
        "by_dependency_type",
        "by_status",
        "tickets"
      ],
      "properties": {
        "source_status": {"type": "string"},
        "ticket_count": {"type": "integer", "minimum": 0},
        "external_or_time_dependency_count": {"type": "integer", "minimum": 0},
        "engineering_dependency_count": {"type": "integer", "minimum": 0},
        "manual_dependency_count": {"type": "integer", "minimum": 0},
        "by_dependency_type": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "by_status": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "tickets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ticket_id",
              "category",
              "owner",
              "dependency_type",
              "status",
              "blocker_count",
              "source_reports",
              "next_action",
              "acceptance_evidence"
            ],
            "properties": {
              "ticket_id": {"type": "string", "pattern": "^us_equity_remediate_[a-z_]+$"},
              "category": {"type": "string", "minLength": 1},
              "owner": {"type": "string", "minLength": 1},
              "dependency_type": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1},
              "blocker_count": {"type": "integer", "minimum": 1},
              "source_reports": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "next_action": {"type": "string", "minLength": 1},
              "acceptance_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "forward_review_progress": {
      "type": "object",
      "required": [
        "observation_days",
        "minimum_complete_days",
        "review_milestones",
        "completed_milestones",
        "next_milestone",
        "days_until_minimum",
        "manual_review_required",
        "manual_review_only_no_paper_or_live_unlock",
        "alpha_validation_claim_allowed",
        "paper_or_live_unlock_allowed"
      ],
      "properties": {
        "observation_days": {"type": "integer", "minimum": 0},
        "minimum_complete_days": {"const": 30},
        "review_milestones": {
          "type": "array",
          "prefixItems": [
            {"const": 30},
            {"const": 60},
            {"const": 90}
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "completed_milestones": {
          "type": "array",
          "items": {"enum": [30, 60, 90]}
        },
        "next_milestone": {
          "anyOf": [
            {"enum": [30, 60, 90]},
            {"type": "null"}
          ]
        },
        "days_until_minimum": {"type": "integer", "minimum": 0},
        "manual_review_required": {"type": "boolean"},
        "manual_review_only_no_paper_or_live_unlock": {"type": "boolean"},
        "alpha_validation_claim_allowed": {"const": false},
        "paper_or_live_unlock_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "review_milestones": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/review_milestone_30"},
        {"$ref": "#/$defs/review_milestone_60_or_90"},
        {"$ref": "#/$defs/review_milestone_60_or_90"}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "evidence_checklist": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_check"},
      "contains": {"type": "object", "required": ["check_id"], "properties": {"check_id": {"const": "no_unsafe_flags"}}}
    },
    "signoff_requirements": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/signoff"},
        {"$ref": "#/$defs/signoff"},
        {"$ref": "#/$defs/signoff"},
        {"$ref": "#/$defs/signoff"}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "paper_or_live_unlock_decision": {
      "type": "object",
      "required": [
        "manual_review_can_unlock_paper_by_itself",
        "manual_review_can_unlock_live_by_itself",
        "required_next_gate_for_paper",
        "required_next_gate_for_live"
      ],
      "properties": {
        "manual_review_can_unlock_paper_by_itself": {"const": false},
        "manual_review_can_unlock_live_by_itself": {"const": false},
        "required_next_gate_for_paper": {"const": "paper_simulation_readiness"},
        "required_next_gate_for_live": {"const": "live_readiness_risk_constitution_and_explicit_human_approval"}
      },
      "additionalProperties": false
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "unsafe_flags": {"type": "array", "items": {"type": "string"}},
    "guardrails": {
      "type": "object",
      "required": [
        "manual_review_packet_only",
        "paper_simulation_allowed",
        "live_order_allowed",
        "private_endpoint_allowed",
        "order_endpoint_allowed",
        "real_order_submitted",
        "manual_approval_recorded"
      ],
      "properties": {
        "manual_review_packet_only": {"const": true},
        "paper_simulation_allowed": {"const": false},
        "live_order_allowed": {"const": false},
        "private_endpoint_allowed": {"const": false},
        "order_endpoint_allowed": {"const": false},
        "real_order_submitted": {"const": false},
        "manual_approval_recorded": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "source_reports": {
      "type": "object",
      "required": [
        "strategy_gate",
        "strategy_evidence_audit",
        "forward_evaluation",
        "data_freshness",
        "small_account_preflight",
        "live_readiness",
        "manual_decision_record",
        "production_pit_intake_status",
        "pit_bundle_acceptance",
        "blocker_taxonomy"
      ],
      "additionalProperties": {"type": "string"}
    },
    "outputs": {
      "type": "object",
      "required": ["json", "markdown"],
      "properties": {
        "json": {"type": "string", "minLength": 1},
        "markdown": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "review_milestone_30": {
      "type": "object",
      "required": ["days", "reached", "required_status"],
      "properties": {
        "days": {"const": 30},
        "reached": {"type": "boolean"},
        "required_status": {"const": "forward_complete_for_manual_review"}
      },
      "additionalProperties": false
    },
    "review_milestone_60_or_90": {
      "type": "object",
      "required": ["days", "reached", "required_status"],
      "properties": {
        "days": {"enum": [60, 90]},
        "reached": {"type": "boolean"},
        "required_status": {"const": "continued_manual_review"}
      },
      "additionalProperties": false
    },
    "evidence_check": {
      "type": "object",
      "required": ["check_id", "passed", "evidence"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "evidence": true
      },
      "additionalProperties": false
    },
    "signoff": {
      "type": "object",
      "required": ["signoff_id", "required", "recorded", "description"],
      "properties": {
        "signoff_id": {"type": "string", "minLength": 1},
        "required": {"const": true},
        "recorded": {"const": false},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
