{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "us_equity_current_head_blocker_taxonomy.schema.json",
  "title": "US Equity Current-HEAD Root Blocker Taxonomy",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at_utc",
    "source_head",
    "status",
    "decision",
    "root_blocker_count",
    "derived_reference_count",
    "root_blockers",
    "derived_references",
    "remediation_tickets",
    "outputs",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": "us_equity_current_head_blocker_taxonomy_v1"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "enum": [
        "blocked",
        "no_root_blockers"
      ]
    },
    "decision": {
      "const": "continue_fail_closed_do_not_unlock_paper_or_live"
    },
    "root_blocker_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "derived_reference_count": {
      "type": "integer",
      "minimum": 0
    },
    "root_blockers": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "code",
          "owner",
          "root_cause",
          "next_action",
          "derived_reference_count"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "root_cause": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "derived_reference_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "derived_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "root_code",
          "source_step",
          "blocker"
        ],
        "properties": {
          "root_code": {
            "type": "string",
            "minLength": 1
          },
          "source_step": {
            "type": "string",
            "minLength": 1
          },
          "blocker": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "remediation_tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ticket_id",
          "category",
          "owner",
          "dependency_type",
          "status",
          "blocker_count",
          "source_reports",
          "next_action",
          "acceptance_evidence"
        ],
        "properties": {
          "ticket_id": {
            "type": "string",
            "pattern": "^us_equity_remediate_[a-z_]+$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "dependency_type": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "blocker_count": {
            "type": "integer",
            "minimum": 1
          },
          "source_reports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "object",
      "required": [
        "json"
      ],
      "properties": {
        "json": {
          "type": "string",
          "pattern": "^[^\\\\]+$"
        }
      },
      "additionalProperties": false
    },
    "safety": {
      "$ref": "#/$defs/safety"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safety": {
      "type": "object",
      "minProperties": 16,
      "additionalProperties": {
        "const": false
      }
    }
  }
}
