{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_universe_manifest.schema.json",
  "title": "QuantStation VNEXT US Equity Universe Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "asset",
    "universe_id",
    "universe_source",
    "selection_rule",
    "calendar_id",
    "as_of",
    "status",
    "symbol_count",
    "symbols",
    "data_versions",
    "point_in_time",
    "survivorship_bias_risk",
    "promotion_ready",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_universe_manifest_v1"},
    "generated_at": {"type": "string", "minLength": 1},
    "asset": {"const": "us_equity"},
    "universe_id": {"type": "string", "minLength": 1},
    "universe_source": {"type": "string", "minLength": 1},
    "selection_rule": {"type": "string", "minLength": 1},
    "calendar_id": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "minLength": 1},
    "status": {"enum": ["partial", "promotion_clean"]},
    "symbol_count": {"type": "integer", "minimum": 0},
    "symbols": {"type": "array", "items": {"type": "string"}},
    "data_versions": {"type": "array", "items": {"type": "string"}},
    "point_in_time": {"type": "boolean"},
    "survivorship_bias_risk": {"type": "string", "minLength": 1},
    "promotion_ready": {"const": false},
    "repo_root_independent": {"type": "boolean"},
    "source_manifest_root": {"type": "string"},
    "latest_data_manifest": {"type": ["string", "null"]},
    "manifest_count": {"type": "integer", "minimum": 0},
    "adjustment_policies": {"type": "array"},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
