{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_universe_manifest.schema.json",
  "title": "QuantStation VNEXT US Equity Universe Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "universe_id",
    "universe_source",
    "asset",
    "calendar_id",
    "as_of",
    "latest_data_manifest",
    "manifest_count",
    "symbol_count",
    "symbols",
    "data_versions",
    "adjustment_policies",
    "selection_rule",
    "survivorship_bias_risk",
    "point_in_time",
    "promotion_ready",
    "blockers",
    "repo_root_independent",
    "source_manifest_root"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_universe_manifest_v1"},
    "generated_at": {"type": "string"},
    "status": {"enum": ["missing", "partial", "complete"]},
    "universe_id": {"type": "string", "minLength": 1},
    "universe_source": {"const": "data_manifests"},
    "asset": {"const": "us_equity"},
    "calendar_id": {"const": "XNYS"},
    "as_of": {"type": "string"},
    "latest_data_manifest": {"type": ["string", "null"]},
    "manifest_count": {"type": "integer", "minimum": 0},
    "symbol_count": {"type": "integer", "minimum": 0},
    "symbols": {"type": "array", "items": {"type": "string"}},
    "data_versions": {"type": "array", "items": {"type": "string"}},
    "adjustment_policies": {"type": "array", "items": {"type": "string"}},
    "selection_rule": {"type": "string"},
    "survivorship_bias_risk": {"type": "string"},
    "point_in_time": {"type": "boolean"},
    "promotion_ready": {"const": false},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "repo_root_independent": {"const": true},
    "source_manifest_root": {"const": "data/manifests"}
  },
  "additionalProperties": false
}
