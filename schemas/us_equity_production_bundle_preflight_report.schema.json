{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/us_equity_production_bundle_preflight_report.schema.json",
  "title": "QuantStation VNEXT US Equity Production Bundle Preflight Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "commit",
    "branch",
    "bundle_root",
    "provider_config_path",
    "local_csv_enabled",
    "require_explicit_bundle_selection",
    "production_bundles_found",
    "sample_bundles_found",
    "fixture_bundles_found",
    "candidate_bundle_ids",
    "selected_bundle_id",
    "selected_bundle_source_type",
    "selected_bundle_manifest_path",
    "selected_bundle_preflight_pass",
    "production_bundle_preflight_pass",
    "gitignore_protection_confirmed",
    "vendor_data_committed_risk",
    "required_files_present",
    "manifest_sha256_present",
    "manifest_record_counts_present",
    "license_note_present",
    "promotion_clean_allowed",
    "promotion_clean_allowed_by_config",
    "promotion_clean_allowed_by_manifest",
    "files",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "us_equity_production_bundle_preflight_report_v1"},
    "generated_at": {"type": "string"},
    "commit": {"type": "string"},
    "branch": {"type": "string"},
    "bundle_root": {"type": "string"},
    "provider_config_path": {"type": "string"},
    "local_csv_enabled": {"type": "boolean"},
    "require_explicit_bundle_selection": {"type": "boolean"},
    "production_bundles_found": {"type": "integer", "minimum": 0},
    "sample_bundles_found": {"type": "integer", "minimum": 0},
    "fixture_bundles_found": {"type": "integer", "minimum": 0},
    "candidate_bundle_ids": {"type": "array", "items": {"type": "string"}},
    "selected_bundle_id": {"type": ["string", "null"]},
    "selected_bundle_source_type": {"enum": ["fixture", "sample", "production", "unknown", null]},
    "selected_bundle_manifest_path": {"type": ["string", "null"]},
    "selected_bundle_preflight_pass": {"type": "boolean"},
    "production_bundle_preflight_pass": {"type": "boolean"},
    "gitignore_protection_confirmed": {"type": "boolean"},
    "vendor_data_committed_risk": {"type": "boolean"},
    "required_files_present": {"type": "boolean"},
    "manifest_sha256_present": {"type": "boolean"},
    "manifest_record_counts_present": {"type": "boolean"},
    "license_note_present": {"type": "boolean"},
    "promotion_clean_allowed": {"type": "boolean"},
    "promotion_clean_allowed_by_config": {"type": "boolean"},
    "promotion_clean_allowed_by_manifest": {"type": "boolean"},
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "present",
          "sha256_present",
          "record_count_present",
          "record_count",
          "actual_sha256"
        ],
        "properties": {
          "path": {"type": ["string", "null"]},
          "present": {"type": "boolean"},
          "sha256_present": {"type": "boolean"},
          "record_count_present": {"type": "boolean"},
          "record_count": {"type": ["integer", "null"], "minimum": 0},
          "actual_sha256": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
