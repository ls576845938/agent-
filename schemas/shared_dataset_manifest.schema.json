{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstation.local/schemas/shared_dataset_manifest.schema.json",
  "title": "QuantStation Immutable Shared Dataset Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "producer_role",
    "producer_commit",
    "published_at",
    "storage_relative_path",
    "data_schema",
    "coverage",
    "readiness_class",
    "quality_status",
    "aggregate_sha256",
    "file_count",
    "total_bytes",
    "files",
    "known_gaps",
    "blockers",
    "guardrails"
  ],
  "properties": {
    "schema_version": {"const": "shared_dataset_manifest_v1"},
    "dataset_id": {"$ref": "#/$defs/id"},
    "dataset_version": {"$ref": "#/$defs/id"},
    "producer_role": {"const": "data_steward"},
    "producer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "published_at": {"type": "string", "format": "date-time"},
    "storage_relative_path": {"type": "string", "pattern": "^datasets/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"},
    "data_schema": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {"start": {"type": "string"}, "end": {"type": "string"}},
      "additionalProperties": false
    },
    "readiness_class": {"enum": ["quality_checked", "research_ready", "backtest_ready", "promotion_evidence_ready"]},
    "quality_status": {"enum": ["pass", "pass_with_research_only_warnings", "blocked"]},
    "aggregate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_count": {"type": "integer", "minimum": 1},
    "total_bytes": {"type": "integer", "minimum": 0},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "known_gaps": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "guardrails": {
      "type": "object",
      "required": [
        "immutable_version",
        "consumer_read_only",
        "promotion_unlock_allowed",
        "paper_or_live_unlock_allowed",
        "private_endpoint_used",
        "order_endpoint_used"
      ],
      "properties": {
        "immutable_version": {"const": true},
        "consumer_read_only": {"const": true},
        "promotion_unlock_allowed": {"const": false},
        "paper_or_live_unlock_allowed": {"const": false},
        "private_endpoint_used": {"const": false},
        "order_endpoint_used": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
  },
  "additionalProperties": false
}
