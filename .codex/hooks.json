{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .codex/hooks/inject_agent_context.py",
            "timeout": 15,
            "statusMessage": "Loading quant governance context"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .codex/hooks/inject_agent_context.py",
            "timeout": 15,
            "statusMessage": "Loading role-specific quant rules"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .codex/hooks/inject_agent_context.py",
            "timeout": 15,
            "statusMessage": "Selecting active pitfall rules"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 .codex/hooks/pre_tool_guard.py",
            "timeout": 10,
            "statusMessage": "Checking quant safety boundaries"
          }
        ]
      }
    ]
  }
}
